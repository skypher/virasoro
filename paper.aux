\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The braided embedding diagram of \(M(c_\star ,\lambda )\) at an interior weight \(\lambda \). A node \(\mu \) stands for the Verma submodule \(M(c_\star ,\mu )\), and an arrow \(\mu \to \nu \) for the embedding \(M(c_\star ,\nu )\subset M(c_\star ,\mu )\). Each node of layer \(k\) has arrows to both nodes of layer \(k+1\). The two submodules of layer \(i\) span the Jantzen layer \(J^i(c_\star ,\lambda )\) (Theorem~\ref {thm:jantzen-smith}), and \(\max (\ell ^+_k,\ell ^-_k)<\ell _{k+1}\).}}{20}{figure.caption.2}\protected@file@percent }
\newlabel{fig:braided}{{1}{20}{The braided embedding diagram of \(M(c_\star ,\lambda )\) at an interior weight \(\lambda \). A node \(\mu \) stands for the Verma submodule \(M(c_\star ,\mu )\), and an arrow \(\mu \to \nu \) for the embedding \(M(c_\star ,\nu )\subset M(c_\star ,\mu )\). Each node of layer \(k\) has arrows to both nodes of layer \(k+1\). The two submodules of layer \(i\) span the Jantzen layer \(J^i(c_\star ,\lambda )\) (Theorem~\ref {thm:jantzen-smith}), and \(\max (\ell ^+_k,\ell ^-_k)<\ell _{k+1}\)}{figure.caption.2}{}}
\newlabel{thm:jantzen-smith}{{8.1}{20}{Smith layers at minimal-model charges}{theorem.8.1}{}}
