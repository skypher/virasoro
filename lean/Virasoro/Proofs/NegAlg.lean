import Virasoro.Algebra
import Mathlib.Algebra.Module.LinearMap.End
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Module
import Mathlib.Tactic.LinearCombination

/-!
# The enveloping algebra of the negative part of the Virasoro algebra

`NegEnv R` is the associative `R`-algebra generated by symbols `g m` (`m : ℤ`), standing for
`L_{-m}`, with `g m = 0` for `m ≤ 0` and
`g m * g n = g n * g m + (n - m) g (m + n)` for `m, n > 0`.
It is the universal enveloping algebra of `Vir_- = ⨁_{m>0} R L_{-m}`.
-/

namespace Virasoro

open FreeAlgebra

variable (R : Type*) [CommRing R]

/-- The defining relations of `U(Vir_-)` on the generators `g m = L_{-m}`. -/
inductive NegRel : FreeAlgebra R ℤ → FreeAlgebra R ℤ → Prop
  | nonpos (m : ℤ) (hm : m ≤ 0) : NegRel (ι R m) 0
  | comm (m n : ℤ) (hm : 0 < m) (hn : 0 < n) :
      NegRel (ι R m * ι R n) (ι R n * ι R m + ((n - m : ℤ) : R) • ι R (m + n))

/-- The universal enveloping algebra of the negative part of the Virasoro algebra. -/
abbrev NegEnv : Type _ := RingQuot (NegRel R)

namespace NegEnv

/-- The generator `g m = L_{-m}` (zero for `m ≤ 0`). -/
noncomputable def g (m : ℤ) : NegEnv R := RingQuot.mkAlgHom R (NegRel R) (ι R m)

variable {R}

theorem g_nonpos {m : ℤ} (hm : m ≤ 0) : g R m = 0 := by
  have h := RingQuot.mkAlgHom_rel R (NegRel.nonpos (R := R) m hm)
  rw [map_zero] at h
  exact h

theorem g_mul_g {m n : ℤ} (hm : 0 < m) (hn : 0 < n) :
    g R m * g R n = g R n * g R m + ((n - m : ℤ) : R) • g R (m + n) := by
  have h := RingQuot.mkAlgHom_rel R (NegRel.comm (R := R) m n hm hn)
  simp only [map_mul, map_add, map_smul] at h
  exact h

/-- The commutation relation applied to an element. -/
theorem g_mul_g_mul {m n : ℤ} (hm : 0 < m) (hn : 0 < n) (u : NegEnv R) :
    g R m * (g R n * u) = g R n * (g R m * u) + ((n - m : ℤ) : R) • (g R (m + n) * u) := by
  rw [← mul_assoc, g_mul_g hm hn, add_mul, mul_assoc, smul_mul_assoc]

/-- Induction over `U(Vir_-)` by left multiplication with generators. -/
theorem induction_left {P : NegEnv R → Prop} (h1 : P 1)
    (hadd : ∀ a b, P a → P b → P (a + b)) (hsmul : ∀ (r : R) a, P a → P (r • a))
    (hg : ∀ m : ℤ, 0 < m → ∀ a, P a → P (g R m * a)) : ∀ a, P a := by
  have h0 : P 0 := by simpa using hsmul 0 1 h1
  have key : ∀ (x : FreeAlgebra R ℤ) (a : NegEnv R), P a →
      P (RingQuot.mkAlgHom R (NegRel R) x * a) := by
    intro x
    induction x using FreeAlgebra.induction with
    | grade0 r =>
      intro a ha
      rw [AlgHom.commutes, ← Algebra.smul_def]
      exact hsmul r a ha
    | grade1 m =>
      intro a ha
      by_cases hm : 0 < m
      · exact hg m hm a ha
      · have : RingQuot.mkAlgHom R (NegRel R) (ι R m) = 0 := g_nonpos (not_lt.1 hm)
        rw [this, zero_mul]
        exact h0
    | add x y hx hy =>
      intro a ha
      rw [map_add, add_mul]
      exact hadd _ _ (hx a ha) (hy a ha)
    | mul x y hx hy =>
      intro a ha
      rw [map_mul, mul_assoc]
      exact hx _ (hy a ha)
  intro a
  obtain ⟨x, rfl⟩ := RingQuot.mkAlgHom_surjective R (NegRel R) a
  have := key x 1 h1
  rwa [mul_one] at this

section lift

variable {W : Type*} [AddCommGroup W] [Module R W]

/-- A family of operators `A m` (`m : ℤ`) is a representation of `Vir_-` if `A m = 0` for
`m ≤ 0` and `A m A n = A n A m + (n - m) A (m + n)` for `m, n > 0`. -/
structure IsNegRep (A : ℤ → Module.End R W) : Prop where
  nonpos : ∀ m : ℤ, m ≤ 0 → A m = 0
  comm : ∀ m n : ℤ, 0 < m → 0 < n → A m * A n = A n * A m + ((n - m : ℤ) : R) • A (m + n)

/-- The algebra homomorphism `U(Vir_-) → End W` of a representation of `Vir_-`. -/
noncomputable def liftEnd (A : ℤ → Module.End R W) (hA : IsNegRep A) :
    NegEnv R →ₐ[R] Module.End R W :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R A, by
    intro x y hxy
    induction hxy with
    | nonpos m hm => rw [lift_ι_apply, map_zero]; exact hA.nonpos m hm
    | comm m n hm hn =>
      simp only [map_mul, map_add, map_smul, lift_ι_apply]
      exact hA.comm m n hm hn⟩

theorem liftEnd_g (A : ℤ → Module.End R W) (hA : IsNegRep A) (m : ℤ) :
    liftEnd A hA (g R m) = A m := by
  rw [liftEnd, g, RingQuot.liftAlgHom_mkAlgHom_apply, lift_ι_apply]

/-- The orbit map `u ↦ u • w₀` of a representation of `Vir_-`. -/
noncomputable def orbit (A : ℤ → Module.End R W) (hA : IsNegRep A) (w₀ : W) :
    NegEnv R →ₗ[R] W :=
  (LinearMap.applyₗ w₀) ∘ₗ (liftEnd A hA).toLinearMap

theorem orbit_one (A : ℤ → Module.End R W) (hA : IsNegRep A) (w₀ : W) :
    orbit A hA w₀ 1 = w₀ := by
  simp [orbit]

theorem orbit_g_mul (A : ℤ → Module.End R W) (hA : IsNegRep A) (w₀ : W) (m : ℤ)
    (u : NegEnv R) : orbit A hA w₀ (g R m * u) = A m (orbit A hA w₀ u) := by
  simp [orbit, liftEnd_g]

end lift

end NegEnv

section central

variable {R} [Algebra ℚ R]

/-- The central term on the diagonal: `ct c k m = c/12 (k^3 - k) δ_{k,m}`. -/
def ct (c : R) (k m : ℤ) : R := if k = m then centralTerm c k else 0

theorem ct_symm (c : R) (a b : ℤ) : ct c a b = ct c b a := by
  unfold ct
  by_cases hab : a = b
  · subst hab; rfl
  · rw [if_neg hab, if_neg (Ne.symm hab)]

theorem centralTerm_neg (c : R) (k : ℤ) : centralTerm c (-k) = -centralTerm c k := by
  simp only [centralTerm]
  rw [← neg_mul, ← map_neg]
  congr 2
  push_cast
  ring

/-- The cocycle identity of the central term. -/
theorem centralTerm_cocycle (c : R) (m n : ℤ) :
    ((2 * m + n : ℤ) : R) * centralTerm c n - ((2 * n + m : ℤ) : R) * centralTerm c m
      = ((n - m : ℤ) : R) * centralTerm c (m + n) := by
  have hz : ∀ z : ℤ, ((z : ℤ) : R) = algebraMap ℚ R (z : ℚ) := fun z => by simp
  simp only [centralTerm, hz]
  rw [← mul_assoc, ← mul_assoc, ← mul_assoc, ← map_mul, ← map_mul, ← map_mul, ← sub_mul,
    ← map_sub]
  congr 2
  push_cast
  ring

end central

end Virasoro
