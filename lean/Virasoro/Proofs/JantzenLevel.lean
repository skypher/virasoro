import Virasoro.Proofs.LevelComp
import Virasoro.Proofs.JantzenSub
import Virasoro.Proofs.Crossing

/-!
# Jantzen layers level by level, and submodules generated by singular vectors

The level-`N` part of the layer `J^i(c,h)` is the image of `J^i_N(c,h)` under the coordinate
map, and the submodule `U(Vir_-) χ` generated by a nonzero vector `χ` of level `ℓ` has a nonzero
level-`N` part exactly when `ℓ ≤ N`.
-/

namespace Virasoro

open Module

section Field

variable {K : Type*} [Field K] [CharZero K] (c h : K)

theorem map_jantzenLayer (N i : ℕ) :
    (jantzenLayer c h N i).map (Verma.pbwCoord N) = jantzen c h i ⊓ Verma.level N := by
  apply le_antisymm
  · refine le_inf ?_ ?_
    · unfold jantzen
      exact le_iSup (fun N => (jantzenLayer c h N i).map (Verma.pbwCoord N)) N
    · rintro _ ⟨u, _, rfl⟩
      exact ⟨u, rfl⟩
  · rintro v ⟨hv1, hv2⟩
    have hcomp : Verma.comp N v ∈ jantzenLayer c h N i := by
      rw [SetLike.mem_coe] at hv1
      unfold jantzen at hv1
      refine Submodule.iSup_induction
        (motive := fun v => Verma.comp N v ∈ jantzenLayer c h N i) _ hv1 ?_ ?_ ?_
      · rintro M _ ⟨u, hu, rfl⟩
        by_cases hMN : M = N
        · subst hMN
          rw [Verma.comp_pbwCoord_same]
          exact hu
        · rw [Verma.comp_pbwCoord_ne hMN]
          exact Submodule.zero_mem _
      · rw [map_zero]
        exact Submodule.zero_mem _
      · intro x y hx hy
        rw [map_add]
        exact Submodule.add_mem _ hx hy
    exact ⟨Verma.comp N v, hcomp, Verma.pbwCoord_comp_of_mem_level hv2⟩

/-- `dim (J^i(c,h))_N = dim J^i_N(c,h)`. -/
theorem finrank_jantzen_inf_level (N i : ℕ) :
    finrank K ↥(jantzen c h i ⊓ Verma.level N) = finrank K (jantzenLayer c h N i) := by
  rw [← map_jantzenLayer]
  exact (Submodule.equivMapOfInjective (Verma.pbwCoord N) (Verma.pbwCoord_injective N)
    (jantzenLayer c h N i)).finrank_eq.symm

end Field

namespace Verma

variable {R : Type*} [CommRing R] [Algebra ℚ R] {c h : R}

theorem negOp_smul_mem_level {ℓ : ℕ} {v : Verma R c h} (hv : v ∈ level ℓ) (w : List ℕ) :
    VirEnv.negOp c w • v ∈ level (ℓ + w.sum) := by
  induction w with
  | nil =>
    rw [negOp_nil_smul, List.sum_nil, add_zero]
    exact hv
  | cons y w ih =>
    rw [negOp_cons_smul]
    refine L_mem_level ?_ ih
    rw [List.sum_cons]
    push_cast
    ring

/-- The level-`N` component of `U(Vir_-) χ` vanishes below the level of `χ`. -/
theorem comp_negSpan_eq_zero {χ : Verma R c h} {ℓ N : ℕ} (hχ : χ ∈ level ℓ) (hN : N < ℓ)
    {v : Verma R c h} (hv : v ∈ negSpan χ) : comp N v = 0 := by
  unfold negSpan at hv
  refine Submodule.span_induction (p := fun v _ => comp N v = 0) ?_ ?_ ?_ ?_ hv
  · rintro _ ⟨w, rfl⟩
    exact comp_of_mem_level_ne (by omega) (negOp_smul_mem_level hχ _)
  · exact map_zero _
  · intro x y _ _ hx hy
    rw [map_add, hx, hy, add_zero]
  · intro a x _ hx
    rw [map_smul, hx, smul_zero]

theorem negOp_replicate_ne_zero {χ : Verma R c h} (hχ : χ ≠ 0) (k : ℕ) :
    VirEnv.negOp c (List.replicate k 1) • χ ≠ 0 := by
  induction k with
  | zero =>
    rw [List.replicate_zero, negOp_nil_smul]
    exact hχ
  | succ k ih =>
    rw [List.replicate_succ, negOp_cons_smul]
    intro h0
    apply ih
    have hinj := L_neg_injective (c := c) (h := h) (m := ((1 : ℕ) : ℤ)) (by norm_num)
    exact hinj (by rw [h0, map_zero])

/-- `U(Vir_-) χ` has a nonzero vector in every level at or above the level of `χ`. -/
theorem exists_ne_zero_negSpan_level {χ : Verma R c h} {ℓ N : ℕ} (hχ0 : χ ≠ 0)
    (hχ : χ ∈ level ℓ) (hN : ℓ ≤ N) :
    ∃ v : Verma R c h, v ≠ 0 ∧ v ∈ negSpan χ ∧ v ∈ level N := by
  refine ⟨VirEnv.negOp c (List.replicate (N - ℓ) 1) • χ, negOp_replicate_ne_zero hχ0 _, ?_, ?_⟩
  · refine Submodule.subset_span ⟨List.replicate (N - ℓ) (1 : ℕ+), ?_⟩
    simp
  · have := negOp_smul_mem_level hχ (List.replicate (N - ℓ) 1)
    rw [List.sum_replicate, smul_eq_mul, mul_one, Nat.add_sub_cancel' hN] at this
    exact this

end Verma

section Arithmetic

variable {p p' r s k : ℕ}

theorem le_ellPlus (hp : 2 ≤ p) (hp' : 2 ≤ p') (hr : 0 < r) (hs : 0 < s) (hsp : s < p')
    (hk : 1 ≤ k) : k ≤ ellPlus p p' r s k := by
  unfold ellPlus
  split_ifs with hpar
  · set j := k / 2 with hj
    have hk2 : k = 2 * j := by omega
    have hj1 : 1 ≤ j := by omega
    have h1 : (p : ℤ) * s + p ≤ p * p' := by
      have : (s : ℤ) + 1 ≤ p' := by exact_mod_cast hsp
      nlinarith [(show (0 : ℤ) ≤ p from by positivity)]
    have h2 : (p' : ℤ) ≤ p' * r := by
      have : (1 : ℤ) ≤ r := by exact_mod_cast hr
      nlinarith [(show (0 : ℤ) ≤ p' from by positivity)]
    have h3 : (p : ℤ) * p' ≤ j * p * p' := by
      have : (1 : ℤ) ≤ j := by exact_mod_cast hj1
      nlinarith [(show (0 : ℤ) ≤ (p : ℤ) * p' from by positivity)]
    have h4 : (2 : ℤ) ≤ (j : ℤ) * p * p' + ((p' : ℤ) * r - (p : ℤ) * s) := by
      have : (2 : ℤ) ≤ p' := by exact_mod_cast hp'
      have : (2 : ℤ) ≤ p := by exact_mod_cast hp
      linarith
    have h5 : (k : ℤ) ≤ (j : ℤ) * ((j : ℤ) * p * p' + ((p' : ℤ) * r - (p : ℤ) * s)) := by
      have : (1 : ℤ) ≤ j := by exact_mod_cast hj1
      rw [hk2]
      push_cast
      nlinarith
    omega
  · set j := k / 2 with hj
    have hk2 : k = 2 * j + 1 := by omega
    have h1 : 2 * j ≤ j * p := by nlinarith
    have h2 : 1 ≤ s + j * p' := by omega
    calc k ≤ r + j * p := by omega
      _ ≤ (r + j * p) * (s + j * p') := Nat.le_mul_of_pos_right _ h2

theorem le_ellMinus (hp : 2 ≤ p) (hp' : 2 ≤ p') (hrp : r < p) (hs : 0 < s) (hsp : s < p')
    (hk : 1 ≤ k) : k ≤ ellMinus p p' r s k := by
  unfold ellMinus
  split_ifs with hpar
  · set j := k / 2 with hj
    have hk2 : k = 2 * j := by omega
    have hj1 : 1 ≤ j := by omega
    have h1 : (p' : ℤ) * r + p' ≤ p * p' := by
      have : (r : ℤ) + 1 ≤ p := by exact_mod_cast hrp
      nlinarith [(show (0 : ℤ) ≤ p' from by positivity)]
    have h2 : (p : ℤ) ≤ p * s := by
      have : (1 : ℤ) ≤ s := by exact_mod_cast hs
      nlinarith [(show (0 : ℤ) ≤ p from by positivity)]
    have h3 : (p : ℤ) * p' ≤ j * p * p' := by
      have : (1 : ℤ) ≤ j := by exact_mod_cast hj1
      nlinarith [(show (0 : ℤ) ≤ (p : ℤ) * p' from by positivity)]
    have h4 : (2 : ℤ) ≤ (j : ℤ) * p * p' - ((p' : ℤ) * r - (p : ℤ) * s) := by
      have : (2 : ℤ) ≤ p' := by exact_mod_cast hp'
      have : (2 : ℤ) ≤ p := by exact_mod_cast hp
      linarith
    have h5 : (k : ℤ) ≤ (j : ℤ) * ((j : ℤ) * p * p' - ((p' : ℤ) * r - (p : ℤ) * s)) := by
      have : (1 : ℤ) ≤ j := by exact_mod_cast hj1
      rw [hk2]
      push_cast
      nlinarith
    omega
  · set j := k / 2 with hj
    have hk2 : k = 2 * j + 1 := by omega
    have h1 : 2 * j ≤ j * p := by nlinarith
    have h1' : j ≤ j * p' := by nlinarith
    have e1 : (j + 1) * p = j * p + p := by ring
    have e2 : (j + 1) * p' = j * p' + p' := by ring
    have h2 : 1 ≤ (j + 1) * p' - s := by omega
    calc k ≤ (j + 1) * p - r := by omega
      _ ≤ ((j + 1) * p - r) * ((j + 1) * p' - s) := Nat.le_mul_of_pos_right _ h2

end Arithmetic

end Virasoro
