import Virasoro.Proofs.PBWSpan
import Virasoro.Proofs.PBWIndep
import Virasoro.Proofs.BaseChange
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas

/-!
# Consequences of the Poincaré–Birkhoff–Witt basis
-/

namespace Virasoro

variable {R : Type*} [CommRing R] [Algebra ℚ R] {c h : R}

namespace Verma

theorem pbwCoord_apply (N : ℕ) (v : Nat.Partition N → R) :
    pbwCoord (c := c) (h := h) N v = ∑ Y : Nat.Partition N, v Y • neg Y.word := by
  simp only [pbwCoord, LinearMap.coe_sum, Finset.sum_apply, LinearMap.smulRight_apply,
    LinearMap.proj_apply]

/-- The vectors `L_{-Y}|h⟩`, over all partitions, span the Verma module. -/
theorem span_neg_word_eq_top :
    Submodule.span R (Set.range fun Y : (Σ N : ℕ, Nat.Partition N) =>
      neg (c := c) (h := h) Y.2.word) = ⊤ := by
  rw [eq_top_iff, ← iSup_level_eq_top]
  refine iSup_le fun N => ?_
  rintro _ ⟨v, rfl⟩
  rw [pbwCoord_apply]
  refine Submodule.sum_mem _ fun Y _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_)
  exact ⟨⟨N, Y⟩, rfl⟩

/-- The coordinate map of level `N` is injective. -/
theorem pbwCoord_injective (N : ℕ) : Function.Injective (pbwCoord (c := c) (h := h) N) := by
  rw [injective_iff_map_eq_zero]
  intro v hv
  rw [pbwCoord_apply] at hv
  have hli := (neg_word_linearIndependent (c := c) (h := h)).comp
    (fun Y : Nat.Partition N => (⟨N, Y⟩ : Σ N : ℕ, Nat.Partition N))
    (fun a b hab => by simpa using hab)
  rw [Fintype.linearIndependent_iff] at hli
  funext Y
  exact hli v hv Y

end Verma

section Kernel

variable {S : Type*} [CommRing S] [Algebra ℚ S] (f : R →+* S) {c' h' : S} (hc : f c = c')
  (hh : f h = h')

/-- If the kernel of `f` is generated by `π`, the kernel of the change of coefficient ring is
`π` times the Verma module. -/
theorem Verma.baseChange_eq_zero {π : R} (hπ : ∀ a : R, f a = 0 → ∃ b, a = π * b)
    (u : Verma R c h) (hu : Verma.baseChange f hc hh u = 0) : ∃ ψ : Verma R c h, u = π • ψ := by
  classical
  have hmem : u ∈ Submodule.span R (Set.range fun Y : (Σ N : ℕ, Nat.Partition N) =>
      Verma.neg (c := c) (h := h) Y.2.word) := by
    rw [Verma.span_neg_word_eq_top]; trivial
  obtain ⟨a, rfl⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).1 hmem
  rw [Finsupp.sum, map_sum] at hu
  simp only [LinearMap.map_smulₛₗ, Verma.baseChange_neg] at hu
  have hli := Verma.neg_word_linearIndependent (c := c') (h := h')
  rw [linearIndependent_iff'] at hli
  have h0 := hli a.support (fun i => f (a i)) hu
  choose b hb using fun i : (Σ N : ℕ, Nat.Partition N) =>
    hπ (if i ∈ a.support then a i else 0) (by
      by_cases hi : i ∈ a.support
      · rw [if_pos hi]; exact h0 i hi
      · rw [if_neg hi, map_zero])
  refine ⟨∑ i ∈ a.support, b i • Verma.neg i.2.word, ?_⟩
  rw [Finsupp.sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun i hi => ?_
  have := hb i
  rw [if_pos hi] at this
  rw [smul_smul, ← this]

end Kernel

end Virasoro
