import Virasoro.Statements.AppA20261125
import Virasoro.Proofs.Sec6H13Integral
import Virasoro.Proofs.Sec6H13Comb
import Mathlib.NumberTheory.Zsqrtd.Basic
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.RingTheory.Localization.AsSubring
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Lemma A.2 of `paper.tex` (`lem:odd-primes`, l.2947–2995)

The ring.  Put `A = ℤ[√−2][b][α]` and reduce modulo an odd prime `ϖ` by
`A → k[b][α]`, `√−2 ↦ r̄`, where `k` is an algebraic closure of `𝔽_ϖ` and `r̄² = −2`.  The kernel
`𝔓` is prime, and `𝒮_𝔭 = A_𝔓 ⊂ Frac(A)` is the localization of the paper (there:
`R = ℤ_(ϖ)[b,b⁻¹,α]_(ϖ)`, `𝒮 = R[q₀]` with `q₀ = −√−2 (b + b⁻¹)/2`, localized at a prime above
`ϖ`).  The maximal ideal is generated by `ϖ`: an element `c` of `ℤ[√−2]` with `c ≡ 0` at `𝔓` either
has its conjugate `c̄` a unit at `𝔓`, and then `c = N(c)/c̄` with `ϖ ∣ N(c)`, or has `c̄ ≡ 0` too,
and then `ϖ` divides `2 Re c` and `2√−2 Im c`, hence `c` (`kerRho0_mem`).  So `𝒮_𝔭` is a
Noetherian local domain with principal maximal ideal: a discrete valuation ring with uniformizer
`ϖ` (`isDVR`, `irreducible_p`).
-/

namespace Virasoro.AppA2

open Polynomial

/-- `ℤ[√−2]`. -/
abbrev OO : Type := ℤ√(-2)

/-- `A = ℤ[√−2][b][α]` (inner variable `b`, outer variable `α`). -/
abbrev AA : Type := Polynomial (Polynomial OO)

/-- `Frac(A)`. -/
abbrev KK : Type := FractionRing AA

instance : IsNoetherianRing OO := by
  refine isNoetherianRing_of_surjective ℤ[X] OO
    ((Polynomial.aeval (Zsqrtd.sqrtd : OO) : ℤ[X] →ₐ[ℤ] OO) : ℤ[X] →+* OO) fun z => ?_
  refine ⟨C z.re + C z.im * X, ?_⟩
  ext <;> simp

instance : NoZeroDivisors OO where
  eq_zero_or_eq_zero_of_mul_eq_zero {a b} h := by
    have h1 := congrArg Zsqrtd.norm h
    rw [Zsqrtd.norm_mul, Zsqrtd.norm_zero] at h1
    rcases mul_eq_zero.1 h1 with h3 | h3
    · exact Or.inl ((Zsqrtd.norm_eq_zero_iff (by norm_num) a).1 h3)
    · exact Or.inr ((Zsqrtd.norm_eq_zero_iff (by norm_num) b).1 h3)

instance : IsDomain OO := NoZeroDivisors.to_isDomain _

instance : CharZero KK := charZero_of_injective_algebraMap (IsFractionRing.injective AA KK)

variable (p : ℕ) [hp : Fact p.Prime]

/-- The residue field `k`: an algebraic closure of `𝔽_ϖ`. -/
abbrev kk : Type := AlgebraicClosure (ZMod p)

/-- `r̄ ∈ k` with `r̄² = −2`. -/
noncomputable def rb : kk p := Classical.choose (IsAlgClosed.exists_eq_mul_self (-2 : kk p))

theorem rb_mul : rb p * rb p = -2 :=
  (Classical.choose_spec (IsAlgClosed.exists_eq_mul_self (-2 : kk p))).symm

/-- `ℤ[√−2] → k`, `√−2 ↦ r̄`. -/
noncomputable def rho0 : OO →+* kk p :=
  Zsqrtd.lift ⟨rb p, by rw [rb_mul]; push_cast; ring⟩

theorem rho0_apply (z : OO) : rho0 p z = z.re + z.im * rb p := by
  simp [rho0]

/-- `A → k[b][α]`. -/
noncomputable def rho : AA →+* Polynomial (Polynomial (kk p)) :=
  mapRingHom (mapRingHom (rho0 p))

/-- `𝔓 = ker(A → k[b][α])`. -/
noncomputable def PP : Ideal AA := RingHom.ker (rho p)

instance PP_isPrime : (PP p).IsPrime := RingHom.ker_isPrime _

theorem primeCompl_le : (PP p).primeCompl ≤ nonZeroDivisors AA := by
  intro x hx
  apply mem_nonZeroDivisors_of_ne_zero
  rintro rfl
  exact hx (Ideal.zero_mem _)

/-- `𝒮_𝔭 = A_𝔓 ⊂ Frac(A)`. -/
noncomputable abbrev SS : Subalgebra AA KK :=
  Localization.subalgebra KK (PP p).primeCompl (primeCompl_le p)

instance : IsLocalization.AtPrime (SS p) (PP p) :=
  Localization.subalgebra.isLocalization_subalgebra KK (PP p).primeCompl (primeCompl_le p)

instance : IsLocalRing (SS p) := IsLocalization.AtPrime.isLocalRing (SS p) (PP p)

instance : IsDomain (SS p) := Subalgebra.isDomain _

instance : IsNoetherianRing (SS p) :=
  IsLocalization.isNoetherianRing (PP p).primeCompl (SS p) inferInstance

theorem mem_PP_iff (a : AA) : a ∈ PP p ↔ rho p a = 0 := RingHom.mem_ker

theorem isUnit_of_rho_ne {a : AA} (ha : rho p a ≠ 0) : IsUnit (algebraMap AA (SS p) a) :=
  IsLocalization.map_units (SS p) (⟨a, fun h => ha ((mem_PP_iff p a).1 h)⟩ : (PP p).primeCompl)

theorem algebraMap_mem_max_iff (a : AA) :
    algebraMap AA (SS p) a ∈ IsLocalRing.maximalIdeal (SS p) ↔ rho p a = 0 := by
  rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (SS p) (PP p) a, mem_PP_iff]

/-- `ℤ[√−2] → 𝒮_𝔭`. -/
noncomputable def emb : OO →+* SS p := (algebraMap AA (SS p)).comp ((C : Polynomial OO →+* AA).comp C)

theorem rho_CC (c : OO) : rho p (C (C c)) = C (C (rho0 p c)) := by
  simp [rho]

theorem two_ne_zero_kk (h2 : p ≠ 2) : (2 : kk p) ≠ 0 := by
  intro h
  have h' : ((2 : ℕ) : kk p) = 0 := by exact_mod_cast h
  rw [CharP.cast_eq_zero_iff (kk p) p] at h'
  exact h2 ((Nat.prime_dvd_prime_iff_eq hp.out Nat.prime_two).1 h')

theorem rb_ne_zero (h2 : p ≠ 2) : rb p ≠ 0 := by
  intro h
  have h1 := rb_mul p
  rw [h, zero_mul] at h1
  exact two_ne_zero_kk p h2 (neg_eq_zero.1 h1.symm)

theorem intCast_kk_eq_zero (z : ℤ) : ((z : ℤ) : kk p) = 0 ↔ ((p : ℕ) : ℤ) ∣ z :=
  CharP.intCast_eq_zero_iff (kk p) p z

/-- An element of `ℤ[√−2]` in `𝔓` is divisible by `ϖ` in `𝒮_𝔭` (paper.tex l.2985–2988). -/
theorem kerRho0_mem (h2 : p ≠ 2) {c : OO} (hc : rho0 p c = 0) :
    emb p c ∈ Ideal.span {((p : ℕ) : SS p)} := by
  rw [Ideal.mem_span_singleton']
  by_cases hs : rho0 p (star c) = 0
  · rw [rho0_apply] at hc hs
    simp only [Zsqrtd.re_star, Zsqrtd.im_star, Int.cast_neg, neg_mul] at hs
    have hre : ((c.re : ℤ) : kk p) = 0 := by
      have h : (2 : kk p) * (c.re : kk p) = 0 := by linear_combination hc + hs
      exact (mul_eq_zero.1 h).resolve_left (two_ne_zero_kk p h2)
    have him : ((c.im : ℤ) : kk p) = 0 := by
      have h : ((2 : kk p) * rb p) * (c.im : kk p) = 0 := by linear_combination hc - hs
      exact (mul_eq_zero.1 h).resolve_left (mul_ne_zero (two_ne_zero_kk p h2) (rb_ne_zero p h2))
    obtain ⟨m, hm⟩ := (intCast_kk_eq_zero p _).1 hre
    obtain ⟨n, hn⟩ := (intCast_kk_eq_zero p _).1 him
    refine ⟨emb p ⟨m, n⟩, ?_⟩
    have hc' : c = ((p : ℤ) : OO) * ⟨m, n⟩ := by
      ext <;> simp [hm, hn]
    rw [hc', map_mul, map_intCast, mul_comm]
    push_cast
    rfl
  · have hu : IsUnit (emb p (star c)) := by
      refine isUnit_of_rho_ne p ?_
      show rho p (C (C (star c))) ≠ 0
      rw [rho_CC]
      exact fun h => hs (C_eq_zero.1 (C_eq_zero.1 h))
    have hN : ((c.norm : ℤ) : kk p) = 0 := by
      have h1 : ((c.norm : ℤ) : OO) = c * star c := Zsqrtd.norm_eq_mul_conj c
      have h2' := congrArg (rho0 p) h1
      rw [map_intCast, map_mul, hc, zero_mul] at h2'
      exact h2'
    obtain ⟨j, hj⟩ := (intCast_kk_eq_zero p _).1 hN
    obtain ⟨u, hu'⟩ := hu
    refine ⟨(j : SS p) * ↑u⁻¹, ?_⟩
    have h3 : emb p c * emb p (star c) = ((p : ℕ) : SS p) * (j : SS p) := by
      rw [← map_mul, ← Zsqrtd.norm_eq_mul_conj, map_intCast, hj]
      push_cast
      ring
    calc (j : SS p) * ↑u⁻¹ * ((p : ℕ) : SS p)
        = ((p : ℕ) : SS p) * (j : SS p) * ↑u⁻¹ := by ring
      _ = emb p c * emb p (star c) * ↑u⁻¹ := by rw [h3]
      _ = emb p c := by rw [← hu', mul_assoc, Units.mul_inv, mul_one]

theorem PP_le (h2 : p ≠ 2) :
    PP p ≤ (Ideal.span {((p : ℕ) : SS p)}).comap (algebraMap AA (SS p)) := by
  have hI : PP p ≤ ((RingHom.ker (rho0 p)).map (C : OO →+* Polynomial OO)).map
      (C : Polynomial OO →+* AA) := by
    intro a ha
    rw [mem_PP_iff] at ha
    refine Ideal.mem_map_C_iff.2 fun n => Ideal.mem_map_C_iff.2 fun m => ?_
    rw [RingHom.mem_ker]
    have h := congrArg (fun f => (f.coeff n).coeff m) ha
    simpa [rho] using h
  refine hI.trans ?_
  rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
  intro c hc
  exact kerRho0_mem p h2 (RingHom.mem_ker.1 hc)

theorem p_mem_max : ((p : ℕ) : SS p) ∈ IsLocalRing.maximalIdeal (SS p) := by
  have h := (algebraMap_mem_max_iff p ((p : ℕ) : AA)).2 (by simp [rho])
  simpa using h

theorem max_eq (h2 : p ≠ 2) :
    IsLocalRing.maximalIdeal (SS p) = Ideal.span {((p : ℕ) : SS p)} := by
  refine le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).2 (p_mem_max p))
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (PP p) (SS p), Ideal.map_le_iff_le_comap]
  exact PP_le p h2

theorem p_ne_zero : ((p : ℕ) : SS p) ≠ 0 := by
  intro h
  have h1 := congrArg (Subalgebra.val (SS p)) h
  rw [map_natCast, map_zero] at h1
  exact Nat.cast_ne_zero.2 hp.out.ne_zero h1

theorem not_isField : ¬ IsField (SS p) := by
  rw [IsLocalRing.isField_iff_maximalIdeal_eq]
  intro h
  have := p_mem_max p
  rw [h, Ideal.mem_bot] at this
  exact p_ne_zero p this

theorem isDVR (h2 : p ≠ 2) : IsDiscreteValuationRing (SS p) := by
  have hP : (IsLocalRing.maximalIdeal (SS p)).IsPrincipal := ⟨⟨_, max_eq p h2⟩⟩
  exact ((IsDiscreteValuationRing.TFAE (SS p) (not_isField p)).out 0 4).2 hP

theorem irreducible_p (h2 : p ≠ 2) : Irreducible ((p : ℕ) : SS p) := by
  have := isDVR p h2
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).2 (max_eq p h2)

/-! ### The elements `b`, `α`, `√−2`, `q₀`, `Y` -/

/-- `b ∈ A`. -/
noncomputable def bA : AA := C X
/-- `α ∈ A`. -/
noncomputable def aA : AA := X
/-- `√−2 ∈ A`. -/
noncomputable def wA : AA := C (C Zsqrtd.sqrtd)

/-- `b ∈ Frac(A)`. -/
noncomputable def bK : KK := algebraMap AA KK bA
/-- `α ∈ Frac(A)`. -/
noncomputable def aK : KK := algebraMap AA KK aA
/-- `√−2 ∈ Frac(A)`. -/
noncomputable def wK : KK := algebraMap AA KK wA
/-- `q₀ = −√−2 (b + b⁻¹)/2`. -/
noncomputable def q0K : KK := -wK * (bK + bK⁻¹) / 2
/-- `Δ = ½ α (α − 2q₀)`. -/
noncomputable def DelK : KK := aK * (aK - 2 * q0K) / 2
/-- `Y = ½ b⁴ α (α − 2q₀)`. -/
noncomputable def YK : KK := bK ^ 4 * aK * (aK - 2 * q0K) / 2

theorem bK_ne_zero : bK ≠ 0 := by
  rw [bK, Ne, map_eq_zero_iff _ (IsFractionRing.injective AA KK), bA]
  exact C_ne_zero.2 X_ne_zero

theorem wK_sq : wK ^ 2 = -2 := by
  rw [wK, ← map_pow, wA, ← map_pow, ← map_pow, sq, Zsqrtd.dmuld, map_intCast, map_intCast,
    map_intCast]
  simp

theorem cT_eq : cT (bK ^ 2) = 1 - 12 * q0K ^ 2 := by
  have hb := bK_ne_zero
  have h : q0K ^ 2 = wK ^ 2 * (bK + bK⁻¹) ^ 2 / 4 := by unfold q0K; ring
  rw [h, wK_sq]
  unfold cT
  field_simp
  ring

theorem half_KK : TFock.half KK = 1 / 2 := by
  unfold TFock.half
  rw [map_div₀, map_one, map_ofNat]

theorem DelK_eq : DelK = TFock.wt aK q0K := by
  unfold TFock.wt DelK
  rw [half_KK]
  ring

theorem rho_bA : rho p bA = C X := by simp [rho, bA]
theorem rho_aA : rho p aA = X := by simp [rho, aA]
theorem rho_wA : rho p wA = C (C (rb p)) := by simp [rho, wA, rho0]

theorem rho_natCast (n : ℕ) : rho p (n : AA) = C (C (n : kk p)) := by
  rw [map_natCast, ← C_eq_natCast, ← C_eq_natCast]

theorem rho_intCast (z : ℤ) : rho p (z : AA) = C (C (z : kk p)) := by
  rw [map_intCast, ← C_eq_intCast, ← C_eq_intCast]

theorem natCast_kk_ne_zero {n : ℕ} (hn : ¬ p ∣ n) : (n : kk p) ≠ 0 := by
  rw [Ne, CharP.cast_eq_zero_iff (kk p) p]
  exact hn

theorem rho_two_ne (h2 : p ≠ 2) : rho p (2 : AA) ≠ 0 := by
  have h : rho p (2 : AA) = C (C (2 : kk p)) := by
    have := rho_natCast p 2
    simpa using this
  rw [h]
  exact C_ne_zero.2 (C_ne_zero.2 (two_ne_zero_kk p h2))

theorem rho_bA_ne : rho p bA ≠ 0 := by
  rw [rho_bA]
  exact C_ne_zero.2 X_ne_zero

/-! ### Membership in `𝒮_𝔭` and units of `𝒮_𝔭` -/

theorem coe_algebraMap_SS (a : AA) : ((algebraMap AA (SS p) a : SS p) : KK) = algebraMap AA KK a :=
  rfl

theorem alg_mem (a : AA) : algebraMap AA KK a ∈ SS p := Subalgebra.algebraMap_mem _ a

/-- `x` is the image of a unit of `𝒮_𝔭`. -/
def IsSU (x : KK) : Prop := ∃ u : (SS p)ˣ, ((u : SS p) : KK) = x

theorem isSU_alg {a : AA} (ha : rho p a ≠ 0) : IsSU p (algebraMap AA KK a) := by
  obtain ⟨u, hu⟩ := isUnit_of_rho_ne p ha
  exact ⟨u, by rw [hu]; rfl⟩

theorem IsSU.mem {x : KK} (hx : IsSU p x) : x ∈ SS p := by
  obtain ⟨u, rfl⟩ := hx
  exact (u : SS p).2

theorem IsSU.inv {x : KK} (hx : IsSU p x) : IsSU p x⁻¹ := by
  obtain ⟨u, rfl⟩ := hx
  refine ⟨u⁻¹, ?_⟩
  have h1 : ((↑u⁻¹ : SS p) : KK) * ((u : SS p) : KK) = 1 := by
    have := congrArg (Subalgebra.val (SS p)) (Units.inv_mul u)
    rwa [map_mul, map_one] at this
  exact eq_inv_of_mul_eq_one_left h1

theorem IsSU.inv_mem {x : KK} (hx : IsSU p x) : x⁻¹ ∈ SS p := hx.inv.mem

theorem IsSU.ne_zero {x : KK} (hx : IsSU p x) : x ≠ 0 := by
  obtain ⟨u, rfl⟩ := hx
  intro h
  have h1 : ((u : SS p) : KK) * ((↑u⁻¹ : SS p) : KK) = 1 := by
    have := congrArg (Subalgebra.val (SS p)) (Units.mul_inv u)
    rwa [map_mul, map_one] at this
  rw [h, zero_mul] at h1
  exact zero_ne_one h1

theorem IsSU.mul {x y : KK} (hx : IsSU p x) (hy : IsSU p y) : IsSU p (x * y) := by
  obtain ⟨u, rfl⟩ := hx
  obtain ⟨v, rfl⟩ := hy
  exact ⟨u * v, by rw [Units.val_mul]; rfl⟩

theorem IsSU.neg {x : KK} (hx : IsSU p x) : IsSU p (-x) := by
  obtain ⟨u, rfl⟩ := hx
  exact ⟨-u, by rw [Units.val_neg]; rfl⟩

theorem IsSU.pow {x : KK} (hx : IsSU p x) (k : ℕ) : IsSU p (x ^ k) := by
  induction k with
  | zero => exact ⟨1, by simp⟩
  | succ k ih => rw [pow_succ]; exact ih.mul p hx

theorem IsSU.prod {ι : Type*} (s : Finset ι) (f : ι → KK) (h : ∀ i ∈ s, IsSU p (f i)) :
    IsSU p (∏ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert i s hi ih =>
    rw [Finset.prod_insert hi]
    exact (h i (Finset.mem_insert_self _ _)).mul p (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

theorem isSU_two (h2 : p ≠ 2) : IsSU p (2 : KK) := by
  have h := isSU_alg p (rho_two_ne p h2)
  rwa [map_ofNat] at h

theorem isSU_bK : IsSU p bK := isSU_alg p (rho_bA_ne p)

theorem bK_mem : bK ∈ SS p := alg_mem p bA
theorem aK_mem : aK ∈ SS p := alg_mem p aA
theorem wK_mem : wK ∈ SS p := alg_mem p wA
theorem binv_mem : bK⁻¹ ∈ SS p := (isSU_bK p).inv_mem
theorem half_mem (h2 : p ≠ 2) : (2 : KK)⁻¹ ∈ SS p := (isSU_two p h2).inv_mem

theorem q0K_mem (h2 : p ≠ 2) : q0K ∈ SS p := by
  rw [q0K, div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.neg_mem _ (wK_mem p))
    (Subalgebra.add_mem _ (bK_mem p) (binv_mem p))) (half_mem p h2)

theorem DelK_mem (h2 : p ≠ 2) : DelK ∈ SS p := by
  rw [DelK, div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (aK_mem p) (Subalgebra.sub_mem _ (aK_mem p)
    (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ 2) (q0K_mem p h2)))) (half_mem p h2)

theorem YK_mem (h2 : p ≠ 2) : YK ∈ SS p := by
  rw [YK, div_eq_mul_inv]
  refine Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _
    (Subalgebra.pow_mem _ (bK_mem p) 4) (aK_mem p)) (Subalgebra.sub_mem _ (aK_mem p)
    (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ 2) (q0K_mem p h2)))) (half_mem p h2)

theorem div_mem {n : ℕ} (hn : ¬ p ∣ n) (z : ℤ) : (z : KK) / (n : KK) ∈ SS p := by
  have hr : rho p (n : AA) ≠ 0 := by
    rw [rho_natCast]
    exact C_ne_zero.2 (C_ne_zero.2 (natCast_kk_ne_zero p hn))
  have h := (isSU_alg p hr).inv_mem
  rw [map_natCast] at h
  rw [div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (Subalgebra.intCast_mem _ z) h

/-! ### The residue map `𝒮_𝔭 → Frac(k[b][α])` -/

/-- `Frac(k[b][α])`. -/
abbrev Kb : Type := FractionRing (Polynomial (Polynomial (kk p)))

/-- `A → k[b][α] → Frac(k[b][α])`. -/
noncomputable def gres : AA →+* Kb p := (algebraMap _ (Kb p)).comp (rho p)

theorem gres_unit (y : (PP p).primeCompl) : IsUnit (gres p y) := by
  refine IsUnit.mk0 _ fun h => y.2 ((mem_PP_iff p y).2 ?_)
  have h' : algebraMap (Polynomial (Polynomial (kk p))) (Kb p) (rho p y) = 0 := h
  exact (map_eq_zero_iff _ (IsFractionRing.injective (Polynomial (Polynomial (kk p))) (Kb p))).1 h'

/-- The residue map. -/
noncomputable def psi : SS p →+* Kb p :=
  IsLocalization.lift (M := (PP p).primeCompl) (S := SS p) (gres_unit p)

theorem psi_alg (a : AA) : psi p (algebraMap AA (SS p) a) = gres p a :=
  IsLocalization.lift_eq _ _

theorem psi_max {x : SS p} (hx : x ∈ IsLocalRing.maximalIdeal (SS p)) : psi p x = 0 := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (PP p) (SS p)] at hx
  have h : Ideal.map (algebraMap AA (SS p)) (PP p) ≤ RingHom.ker (psi p) := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, psi_alg, gres, RingHom.comp_apply,
      (mem_PP_iff p a).1 ha, map_zero]
  exact h hx

/-- The elements of `𝒮_𝔭`. -/
noncomputable def bS : SS p := algebraMap AA (SS p) bA
noncomputable def aS : SS p := algebraMap AA (SS p) aA
noncomputable def wS : SS p := algebraMap AA (SS p) wA
noncomputable def binvS : SS p := ⟨bK⁻¹, binv_mem p⟩
noncomputable def halfS (h2 : p ≠ 2) : SS p := ⟨2⁻¹, half_mem p h2⟩
noncomputable def q0S (h2 : p ≠ 2) : SS p := -wS p * (bS p + binvS p) * halfS p h2
noncomputable def YS (h2 : p ≠ 2) : SS p := bS p ^ 4 * aS p * (aS p - 2 * q0S p h2) * halfS p h2

theorem coe_bS : ((bS p : SS p) : KK) = bK := rfl
theorem coe_aS : ((aS p : SS p) : KK) = aK := rfl

theorem coe_q0S (h2 : p ≠ 2) : ((q0S p h2 : SS p) : KK) = q0K := by
  rw [q0K, div_eq_mul_inv]
  rfl

theorem coe_YS (h2 : p ≠ 2) : ((YS p h2 : SS p) : KK) = YK := by
  rw [YK, div_eq_mul_inv, ← coe_q0S p h2]
  rfl

theorem psi_bS : psi p (bS p) = algebraMap _ (Kb p) (C X : Polynomial (Polynomial (kk p))) := by
  rw [bS, psi_alg, gres, RingHom.comp_apply, rho_bA]

theorem psi_aS : psi p (aS p) = algebraMap _ (Kb p) (X : Polynomial (Polynomial (kk p))) := by
  rw [aS, psi_alg, gres, RingHom.comp_apply, rho_aA]

theorem psi_wS : psi p (wS p) = algebraMap _ (Kb p) (C (C (rb p))) := by
  rw [wS, psi_alg, gres, RingHom.comp_apply, rho_wA]

theorem psi_binvS : psi p (binvS p) = (psi p (bS p))⁻¹ := by
  have h : binvS p * bS p = 1 := Subtype.ext (inv_mul_cancel₀ bK_ne_zero)
  have h' := congrArg (psi p) h
  rw [map_mul, map_one] at h'
  exact eq_inv_of_mul_eq_one_left h'

theorem psi_halfS (h2 : p ≠ 2) : psi p (halfS p h2) = 2⁻¹ := by
  have h : halfS p h2 * 2 = 1 := Subtype.ext (inv_mul_cancel₀ two_ne_zero)
  have h' := congrArg (psi p) h
  rw [map_mul, map_one, map_ofNat] at h'
  exact eq_inv_of_mul_eq_one_left h'

/-- `k → Frac(k[b][α])`. -/
noncomputable def iotak : kk p →+* Kb p :=
  (algebraMap (Polynomial (Polynomial (kk p))) (Kb p)).comp
    ((C : Polynomial (kk p) →+* Polynomial (Polynomial (kk p))).comp C)

/-- `Ȳ = ½ (b⁴ α² + r̄ (b⁵ + b³) α) ∈ k[b][α]`. -/
noncomputable def Ybar : Polynomial (Polynomial (kk p)) :=
  C (C ((2 : kk p)⁻¹)) * (C (X ^ 4) * X ^ 2 + C (C (rb p) * (X ^ 5 + X ^ 3)) * X)

theorem algebraMap_C_C (c : kk p) :
    algebraMap _ (Kb p) (C (C c) : Polynomial (Polynomial (kk p))) = iotak p c := rfl

theorem psi_YS (h2 : p ≠ 2) : psi p (YS p h2) = algebraMap _ (Kb p) (Ybar p) := by
  have hb : algebraMap _ (Kb p) (C X : Polynomial (Polynomial (kk p))) ≠ 0 := by
    rw [Ne, map_eq_zero_iff _ (IsFractionRing.injective _ _)]
    exact C_ne_zero.2 X_ne_zero
  have h2' : iotak p (2⁻¹ : kk p) = 2⁻¹ := by
    rw [map_inv₀, map_ofNat]
  have h2K : (2 : Kb p) ≠ 0 := by
    rw [← map_ofNat (iotak p) 2]
    exact (_root_.map_ne_zero _).2 (two_ne_zero_kk p h2)
  simp only [YS, q0S, map_mul, map_sub, map_neg, map_add, map_pow, map_ofNat, psi_bS, psi_aS,
    psi_wS, psi_binvS, psi_halfS, Ybar, algebraMap_C_C, h2']
  field_simp
  ring

/-! ### `t` and `Y` are algebraically independent over `𝔽_ϖ` in the residue field -/

noncomputable def evb : MvPolynomial (Fin 2) (kk p) →+* Polynomial (Polynomial (kk p)) :=
  MvPolynomial.eval₂Hom (C.comp C) ![C (X ^ 2), Ybar p]

noncomputable def thetab : MvPolynomial (Fin 2) (kk p) →+* Polynomial (Polynomial (kk p)) :=
  MvPolynomial.eval₂Hom (C.comp C) ![C X, X]

noncomputable def thetabInv : Polynomial (Polynomial (kk p)) →+* MvPolynomial (Fin 2) (kk p) :=
  eval₂RingHom (eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)) (MvPolynomial.X 1)

theorem thetab_injective : Function.Injective (thetab p) := by
  have h : (thetabInv p).comp (thetab p) = RingHom.id _ := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [thetab, thetabInv]
    · fin_cases i <;> simp [thetab, thetabInv]
  intro a b hab
  have := congrArg (thetabInv p) hab
  rwa [← RingHom.comp_apply, ← RingHom.comp_apply, h] at this

/-- `q(t) ↦ q(b²)`. -/
noncomputable def phib : Polynomial (kk p) →+* Polynomial (kk p) := eval₂RingHom C (X ^ 2)

theorem phib_injective : Function.Injective (phib p) := by
  rw [injective_iff_map_eq_zero]
  intro q hq
  have hq' : q.comp (X ^ 2) = 0 := hq
  rcases comp_eq_zero_iff.1 hq' with h | ⟨_, h⟩
  · exact h
  · exfalso
    have h3 := congrArg (fun r => r.coeff 2) h
    simp at h3

/-- `g(t,Y) ↦ g(b², Ȳ)`. -/
noncomputable def Phib : Polynomial (Polynomial (kk p)) →+* Polynomial (Polynomial (kk p)) :=
  eval₂RingHom (C.comp (phib p)) (Ybar p)

theorem Phib_injective (h2 : p ≠ 2) : Function.Injective (Phib p) := by
  rw [injective_iff_map_eq_zero]
  intro g hg
  have hg' : (g.map (phib p)).comp (Ybar p) = 0 := by
    rw [comp, eval₂_map]
    exact hg
  rcases comp_eq_zero_iff.1 hg' with h | ⟨_, h⟩
  · exact Polynomial.map_injective _ (phib_injective p) (by rw [h, Polynomial.map_zero])
  · exfalso
    have h3 := congrArg (fun r => (r.coeff 2).coeff 4) h
    have h4 : ((Ybar p).coeff 2).coeff 4 = (2 : kk p)⁻¹ := by
      rw [Ybar, coeff_C_mul, coeff_add, coeff_C_mul_X_pow, coeff_C_mul_X, if_pos rfl,
        if_neg (by norm_num), add_zero, coeff_C_mul_X_pow, if_pos rfl]
    simp only [h4, coeff_C] at h3
    norm_num at h3
    exact two_ne_zero_kk p h2 h3

theorem evb_eq : evb p = (Phib p).comp (thetab p) := by
  refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
  · simp [evb, thetab, Phib, phib]
  · fin_cases i <;> simp [evb, thetab, Phib, phib]

theorem evb_injective (h2 : p ≠ 2) : Function.Injective (evb p) := by
  rw [evb_eq, RingHom.coe_comp]
  exact (Phib_injective p h2).comp (thetab_injective p)

theorem psi_eval₂ (f : MvPolynomial (Fin 2) ℤ) (v : Fin 2 → SS p) :
    psi p (MvPolynomial.eval₂ (Int.castRingHom (SS p)) v f) =
      MvPolynomial.aeval (fun i => psi p (v i)) f := by
  induction f using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.eval₂_C, MvPolynomial.aeval_C]
    simp
  | add f g hf hg => rw [MvPolynomial.eval₂_add, map_add, map_add, hf, hg]
  | mul_X f i hf =>
    rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, map_mul, hf, MvPolynomial.aeval_X]

theorem aeval_algebraMap_eq (f : MvPolynomial (Fin 2) ℤ)
    (w : Fin 2 → Polynomial (Polynomial (kk p))) :
    MvPolynomial.aeval (fun i => algebraMap _ (Kb p) (w i)) f =
      algebraMap _ (Kb p) (MvPolynomial.eval₂Hom (C.comp C) w
        (MvPolynomial.map (Int.castRingHom (kk p)) f)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add f g hf hg => rw [map_add, hf, hg, map_add, map_add, map_add]
  | mul_X f i hf =>
    rw [map_mul, MvPolynomial.aeval_X, hf, map_mul, MvPolynomial.map_X, map_mul,
      MvPolynomial.eval₂Hom_X', map_mul]

/-- Clause "t and Y are algebraically independent over `𝔽_ϖ` in the residue field"
(paper.tex l.2952–2953, l.2988–2990). -/
theorem not_mem_max (h2 : p ≠ 2) (f : MvPolynomial (Fin 2) ℤ)
    (hf : ∃ e, ¬ ((p : ℕ) : ℤ) ∣ f.coeff e) :
    MvPolynomial.eval₂ (Int.castRingHom (SS p)) (![bS p ^ 2, YS p h2] : Fin 2 → SS p) f ∉
      IsLocalRing.maximalIdeal (SS p) := by
  intro hm
  have h0 := psi_max p hm
  rw [psi_eval₂] at h0
  have hv : (fun i => psi p ((![bS p ^ 2, YS p h2] : Fin 2 → SS p) i)) =
      fun i => algebraMap _ (Kb p) ((![C (X ^ 2), Ybar p] :
        Fin 2 → Polynomial (Polynomial (kk p))) i) := by
    funext i
    fin_cases i
    · simp [psi_bS, map_pow]
    · simp [psi_YS]
  rw [hv, aeval_algebraMap_eq, map_eq_zero_iff _ (IsFractionRing.injective _ _)] at h0
  have h3 : MvPolynomial.map (Int.castRingHom (kk p)) f = 0 :=
    evb_injective p h2 (by rw [map_zero]; exact h0)
  obtain ⟨e, he⟩ := hf
  apply he
  have h4 := congrArg (fun g => MvPolynomial.coeff e g) h3
  simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_zero, eq_intCast] at h4
  exact (intCast_kk_eq_zero p _).1 h4

/-! ### `b` is transcendental over `ℚ` -/

theorem transcendental_bK : Transcendental ℚ bK := by
  have hT := IsScalarTower.of_algebraMap_eq (R := ℤ) (S := ℚ) (A := KK) fun x => by simp
  have hX : Transcendental ℤ (X : Polynomial OO) :=
    Transcendental.restrictScalars (R := ℤ) (S := OO) (algebraMap ℤ OO).injective_int
      (Polynomial.transcendental_X (R := OO))
  have h1 : Transcendental ℤ bK := by
    rw [bK, transcendental_algebraMap_iff (IsFractionRing.injective AA KK), bA,
      show (C X : AA) = algebraMap (Polynomial OO) AA X from rfl,
      transcendental_algebraMap_iff (Polynomial.C_injective)]
    exact hX
  intro h
  exact h1 ((IsFractionRing.isAlgebraic_iff ℤ ℚ KK).2 h)

/-! ### The Kac factors are units of `𝒮_𝔭` (paper.tex l.2985–2987) -/

/-- `8b²(Δ − h_{u,v}) ∈ A`. -/
noncomputable def Puv (u v : ℤ) : AA :=
  C (C ((4 : ℤ) : OO) * X ^ 2) * X ^ 2 + C (C ((4 : ℤ) : OO) * C Zsqrtd.sqrtd * (X ^ 3 + X)) * X +
    C (C ((-2 : ℤ) : OO) * ((X ^ 2 + 1) ^ 2 - (C (u : OO) * X ^ 2 + C (v : OO)) ^ 2))

theorem alg_CX : algebraMap AA KK (C X) = bK := rfl
theorem alg_X : algebraMap AA KK X = aK := rfl
theorem alg_CCw : algebraMap AA KK (C (C Zsqrtd.sqrtd)) = wK := rfl

theorem Puv_eq (u v : ℤ) :
    algebraMap AA KK (Puv u v) = 8 * bK ^ 2 * (DelK - hT u v (bK ^ 2)) := by
  have hb := bK_ne_zero
  simp only [Puv, map_add, map_mul, map_sub, map_pow, map_one, map_intCast, alg_CX, alg_X,
    alg_CCw]
  unfold DelK q0K hT
  push_cast
  field_simp
  ring

theorem rho_Puv_coeff (u v : ℤ) : (rho p (Puv u v)).coeff 2 = C ((4 : ℤ) : kk p) * X ^ 2 := by
  simp only [rho, Puv, coe_mapRingHom, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_pow,
    map_X, map_C]
  rw [coeff_add, coeff_add, coeff_C_mul_X_pow, coeff_C_mul_X, coeff_C, if_pos rfl,
    if_neg (by norm_num), if_neg (by norm_num), add_zero, add_zero]
  simp only [map_intCast]

theorem rho_Puv_ne (h2 : p ≠ 2) (u v : ℤ) : rho p (Puv u v) ≠ 0 := by
  intro h
  have h1 := rho_Puv_coeff p u v
  rw [h, coeff_zero] at h1
  have h4 : ((4 : ℤ) : kk p) ≠ 0 := by
    have e : ((4 : ℤ) : kk p) = 2 * 2 := by push_cast; ring
    rw [e]
    exact mul_ne_zero (two_ne_zero_kk p h2) (two_ne_zero_kk p h2)
  exact mul_ne_zero (C_ne_zero.2 h4) (pow_ne_zero 2 X_ne_zero) h1.symm

theorem isSU_factor (h2 : p ≠ 2) (u v : ℤ) : IsSU p (DelK - hT u v (bK ^ 2)) := by
  have h8 : IsSU p (8 * bK ^ 2) := by
    have e : (8 : KK) = 2 ^ 3 := by norm_num
    rw [e]
    exact ((isSU_two p h2).pow p 3).mul p ((isSU_bK p).pow p 2)
  have hP := isSU_alg p (rho_Puv_ne p h2 u v)
  rw [Puv_eq] at hP
  have e : DelK - hT u v (bK ^ 2) = (8 * bK ^ 2)⁻¹ * (8 * bK ^ 2 * (DelK - hT u v (bK ^ 2))) := by
    rw [← mul_assoc, inv_mul_cancel₀ (h8.ne_zero p), one_mul]
  rw [e]
  exact (h8.inv p).mul p hP

/-! ### `M! G_{M−s}⁻¹` has entries in `𝒮_𝔭` (paper.tex l.2960–2995) -/

/-- `B_n(q₀, 2q₀ − α)`. -/
noncomputable def Bp (n : ℕ) : Matrix (Nat.Partition n) (Nat.Partition n) KK :=
  TFock.Bm (2 * q0K - aK) q0K n

/-- `B_n(q₀, α)`. -/
noncomputable def Bq (n : ℕ) : Matrix (Nat.Partition n) (Nat.Partition n) KK := TFock.Bm aK q0K n

/-- `det B_n(q₀,2q₀−α) det B_n(q₀,α)`. -/
noncomputable def delta (n : ℕ) : KK := (Bp n).det * (Bq n).det

theorem gram_fac (n : ℕ) : gram (cT (bK ^ 2)) DelK n =
    Bp n * Matrix.diagonal (fun Z : Nat.Partition n => ((TFock.Dm Z : ℤ) : KK)) *
      (Bq n).transpose := by
  rw [cT_eq, DelK_eq]
  exact TFock.gram_factor aK q0K n

theorem gram_det (n : ℕ) : (gram (cT (bK ^ 2)) DelK n).det = delta n * (dprod n : KK) := by
  rw [gram_fac, Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal, Matrix.det_transpose, delta,
    dprod]
  push_cast
  ring

theorem isSU_delta (hK : Cited_KacDeterminant) (h2 : p ≠ 2) (n : ℕ) : IsSU p (delta n) := by
  have hd0 : (dprod n : KK) ≠ 0 := Int.cast_ne_zero.2 (dprod_ne_zero sub_h13_lagrange n)
  have heq : delta n * (dprod n : KK) = (kacK n : KK) *
      ∏ a ∈ labels n, (DelK - hT (a.1 : ℤ) (a.2 : ℤ) (bK ^ 2)) ^
        Fintype.card (Nat.Partition (n - a.lvl)) := by
    rw [← gram_det]
    exact kac_det_T hK (pow_ne_zero 2 bK_ne_zero) DelK n
  have hk : (kacK n : KK) = 2 ^ lenSum n * ((|dprod n| : ℤ) : KK) := by
    have := congrArg (Int.cast : ℤ → KK) (sub_h13_detD n)
    push_cast at this
    rw [dprod]
    exact this
  have hPi : IsSU p (∏ a ∈ labels n, (DelK - hT (a.1 : ℤ) (a.2 : ℤ) (bK ^ 2)) ^
      Fintype.card (Nat.Partition (n - a.lvl))) :=
    IsSU.prod p _ _ fun a _ => (isSU_factor p h2 _ _).pow p _
  have h2n : IsSU p ((2 : KK) ^ lenSum n) := (isSU_two p h2).pow p _
  rcases abs_choice (dprod n) with h | h
  · rw [h] at hk
    have e : delta n = 2 ^ lenSum n * ∏ a ∈ labels n, (DelK - hT (a.1 : ℤ) (a.2 : ℤ) (bK ^ 2)) ^
        Fintype.card (Nat.Partition (n - a.lvl)) := by
      apply mul_right_cancel₀ hd0
      rw [heq, hk]
      ring
    rw [e]
    exact h2n.mul p hPi
  · rw [h] at hk
    have e : delta n = -(2 ^ lenSum n * ∏ a ∈ labels n, (DelK - hT (a.1 : ℤ) (a.2 : ℤ) (bK ^ 2)) ^
        Fintype.card (Nat.Partition (n - a.lvl))) := by
      apply mul_right_cancel₀ hd0
      rw [heq, hk]
      push_cast
      ring
    rw [e]
    exact (h2n.mul p hPi).neg p

theorem fact_diag (n : ℕ) :
    (n.factorial : KK) • Matrix.diagonal
        (fun Z : Nat.Partition n => ∏ W ∈ Finset.univ.erase Z, ((TFock.Dm W : ℤ) : KK)) =
      (dprod n : KK) • Matrix.diagonal (fun Z : Nat.Partition n => ((mK n Z : ℤ) : KK)) := by
  rw [← Matrix.diagonal_smul, ← Matrix.diagonal_smul]
  congr 1
  funext Z
  simp only [Pi.smul_apply, smul_eq_mul]
  have e1 : (dprod n : KK) = ((TFock.Dm Z : ℤ) : KK) *
      ∏ W ∈ Finset.univ.erase Z, ((TFock.Dm W : ℤ) : KK) := by
    rw [dprod, Int.cast_prod,
      Finset.mul_prod_erase _ (fun W => ((TFock.Dm W : ℤ) : KK)) (Finset.mem_univ Z)]
  have e2 : (n.factorial : KK) = ((TFock.Dm Z : ℤ) : KK) * ((mK n Z : ℤ) : KK) := by
    have := congrArg (Int.cast : ℤ → KK) (mK_spec sub_h13_lagrange n Z)
    push_cast at this
    exact this.symm
  rw [e1, e2]
  ring

theorem half_mem_sub (h2 : p ≠ 2) : TFock.half KK ∈ (SS p).toSubring := by
  rw [half_KK, one_div]
  exact half_mem p h2

theorem Bp_mem (h2 : p ≠ 2) (n : ℕ) (Y Z : Nat.Partition n) : Bp n Y Z ∈ (SS p).toSubring :=
  TFock.Bm_mem (half_mem_sub p h2)
    (Subalgebra.sub_mem _ (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ 2) (q0K_mem p h2))
      (aK_mem p)) (q0K_mem p h2) Y Z

theorem Bq_mem (h2 : p ≠ 2) (n : ℕ) (Y Z : Nat.Partition n) : Bq n Y Z ∈ (SS p).toSubring :=
  TFock.Bm_mem (half_mem_sub p h2) (aK_mem p) (q0K_mem p h2) Y Z

theorem gram_det_ne (hK : Cited_KacDeterminant) (h2 : p ≠ 2) (n : ℕ) :
    (gram (cT (bK ^ 2)) DelK n).det ≠ 0 := by
  rw [gram_det]
  exact mul_ne_zero ((isSU_delta p hK h2 n).ne_zero p)
    (Int.cast_ne_zero.2 (dprod_ne_zero sub_h13_lagrange n))

theorem entry_mem_aux (hK : Cited_KacDeterminant) (h2 : p ≠ 2) (M n : ℕ)
    (hdvd : n.factorial ∣ M.factorial) (Z Z' : Nat.Partition n) :
    (M.factorial : KK) * (gram (cT (bK ^ 2)) DelK n)⁻¹ Z Z' ∈ SS p := by
  have hδ := isSU_delta p hK h2 n
  have hd0 : (dprod n : KK) ≠ 0 := Int.cast_ne_zero.2 (dprod_ne_zero sub_h13_lagrange n)
  have hnf : (n.factorial : KK) ≠ 0 := Nat.cast_ne_zero.2 n.factorial_ne_zero
  have hMn : (M.factorial : KK) = ((M.factorial / n.factorial : ℕ) : KK) * (n.factorial : KK) := by
    rw [← Nat.cast_mul, Nat.div_mul_cancel hdvd]
  have hinv : (gram (cT (bK ^ 2)) DelK n)⁻¹ = (delta n * (dprod n : KK))⁻¹ •
      ((Bq n).transpose.adjugate * (Matrix.diagonal
        (fun Z : Nat.Partition n => ∏ W ∈ Finset.univ.erase Z, ((TFock.Dm W : ℤ) : KK)) *
        (Bp n).adjugate)) := by
    rw [Matrix.inv_def, Ring.inverse_eq_inv', gram_det, gram_fac, Matrix.adjugate_mul_distrib,
      Matrix.adjugate_mul_distrib, Matrix.adjugate_diagonal]
  have hdiag : Matrix.diagonal
      (fun Z : Nat.Partition n => ∏ W ∈ Finset.univ.erase Z, ((TFock.Dm W : ℤ) : KK)) =
      ((n.factorial : KK)⁻¹ * (dprod n : KK)) •
        Matrix.diagonal (fun Z : Nat.Partition n => ((mK n Z : ℤ) : KK)) := by
    rw [mul_smul, ← fact_diag, smul_smul, inv_mul_cancel₀ hnf, one_smul]
  have hE : ((Bq n).transpose.adjugate *
      (Matrix.diagonal (fun Z : Nat.Partition n => ((mK n Z : ℤ) : KK)) * (Bp n).adjugate)) Z Z' ∈
      (SS p).toSubring := by
    refine mul_mem_entries _ _ _ (adjugate_mem _ _ fun i j => Bq_mem p h2 n j i)
      (mul_mem_entries _ _ _ (fun i j => ?_) (adjugate_mem _ _ (Bp_mem p h2 n))) Z Z'
    rw [Matrix.diagonal_apply]
    split_ifs
    exacts [intCast_mem _ _, Subring.zero_mem _]
  rw [hinv, hdiag, Matrix.smul_mul, Matrix.mul_smul, smul_smul, Matrix.smul_apply, smul_eq_mul]
  have e : (M.factorial : KK) * ((delta n * (dprod n : KK))⁻¹ *
      ((n.factorial : KK)⁻¹ * (dprod n : KK)) *
      ((Bq n).transpose.adjugate * (Matrix.diagonal
        (fun Z : Nat.Partition n => ((mK n Z : ℤ) : KK)) * (Bp n).adjugate)) Z Z') =
      ((M.factorial / n.factorial : ℕ) : KK) * (delta n)⁻¹ *
      ((Bq n).transpose.adjugate * (Matrix.diagonal
        (fun Z : Nat.Partition n => ((mK n Z : ℤ) : KK)) * (Bp n).adjugate)) Z Z' := by
    rw [hMn]
    field_simp
  rw [e]
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _) (hδ.inv_mem p)) hE

theorem entry_mem (hK : Cited_KacDeterminant) (h2 : p ≠ 2) (M s : ℕ)
    (Z Z' : Nat.Partition (M - s)) :
    (M.factorial : KK) * (gram (cT (bK ^ 2)) DelK (M - s))⁻¹ Z Z' ∈ SS p :=
  entry_mem_aux p hK h2 M (M - s) (Nat.factorial_dvd_factorial (Nat.sub_le M s)) Z Z'

/-! ### Lemma A.2 -/

/-- Lemma A.2 (paper.tex l.2947–2995), with the Kac determinant formula cited as in the paper.
Paper label: lem:odd-primes -/
theorem lem_odd_primes_of_cited (hK : Cited_KacDeterminant) : Stmt_lem_odd_primes := by
  intro ϖ hϖ h2
  have : Fact ϖ.Prime := ⟨hϖ⟩
  refine ⟨KK, inferInstance, inferInstance, (SS ϖ).toSubring, isDVR ϖ h2, bS ϖ, q0S ϖ h2, aS ϖ,
    YS ϖ h2, irreducible_p ϖ h2, fun z n hn => div_mem ϖ hn z,
    isUnit_of_rho_ne ϖ (rho_bA_ne ϖ), transcendental_bK, ?_, ?_,
    fun f hf => ?_, fun M s hs => ?_⟩
  · show cT (bK ^ 2) = 1 - 12 * ((q0S ϖ h2 : SS ϖ) : KK) ^ 2
    rw [coe_q0S]
    exact cT_eq
  · show ((YS ϖ h2 : SS ϖ) : KK) = bK ^ 4 * aK * (aK - 2 * ((q0S ϖ h2 : SS ϖ) : KK)) / 2
    rw [coe_YS, coe_q0S]
    rfl
  · rw [MvPolynomial.aeval_def, algebraMap_int_eq]
    exact not_mem_max ϖ h2 f hf
  · show (gram (cT (bK ^ 2)) (aK * (aK - 2 * ((q0S ϖ h2 : SS ϖ) : KK)) / 2) (M - s)).det ≠ 0 ∧
      ∀ Z Z' : Nat.Partition (M - s), (M.factorial : KK) *
        (gram (cT (bK ^ 2)) (aK * (aK - 2 * ((q0S ϖ h2 : SS ϖ) : KK)) / 2) (M - s))⁻¹ Z Z' ∈
          (SS ϖ).toSubring
    rw [coe_q0S]
    exact ⟨gram_det_ne ϖ hK h2 (M - s), fun Z Z' => entry_mem ϖ hK h2 M s Z Z'⟩

end Virasoro.AppA2
