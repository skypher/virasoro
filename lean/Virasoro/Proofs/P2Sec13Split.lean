import Virasoro.Proofs.P2Sec11LayerBasis
import Virasoro.Proofs.P2Sec9IrrTrace
import Virasoro.Proofs.P2Sec9OrbitReg
import Virasoro.Proofs.P2Sec9Ratio
import Virasoro.Proofs.TwoBranchA
import Virasoro.Proofs.Sec6Kac

/-!
# Lemma 13.1, Step 1 (generic-`τ` splitting, equation (13.2)), paper.tex l.2883–2913

For generic `b` the module `M(c(b),h_{R,S}(b))` has the one proper submodule `U(Vir_-)χ_{R,S}(b)`;
the `Δ`-Jantzen decomposition of `F_N` then has the two layers `0` and `1`.  This module proves
the regularity of the second Verma coefficient and reduces (13.2) to three sub-statements.
-/

namespace Virasoro.P2

open Virasoro Polynomial

/-- `F_M(c,Δ,d)` has no pole at a weight where `G_M(c,Δ)` is invertible. -/
theorem poleOrder_Frat_of_det {c d z : ℂ} {M : ℕ} (h : (gram c z M).det ≠ 0) :
    poleOrder (Frat c d M) z = 0 := by
  have hdet0 : algebraMap ℂ[X] (RatFunc ℂ) (gramPoly c M).det ≠ 0 := fun h0 =>
    gramPoly_det_ne_zero _ M
      ((map_eq_zero_iff _ (IsFractionRing.injective ℂ[X] (RatFunc ℂ))).1 h0)
  refine poleOrder_eq_zero_of_mul (P := Fnum c d M) (Q := (gramPoly c M).det) ?_ ?_
  · rw [Frat, div_mul_cancel₀ _ hdet0]
  · rwa [gramPoly_det_eval]

/-- At generic `b` the shifted weight `h_{R,-S}(b) = h_{R,S}(b) + RS` is no Kac weight, so every
`F_M(c(b),Δ,d)` is regular there (the module `M(c(b),h_{R,-S}(b))` is irreducible). -/
theorem generic_out_regular (hK : Cited_KacDeterminant) {b : ℂ} (hb : b ≠ 0)
    (hirr : ∀ q : ℚ, b ^ 2 ≠ (q : ℂ)) {R S : ℕ} (hR : 0 < R) (hS : 0 < S) (d : ℂ) (M : ℕ) :
    (gram (kacC b) (kacH (R : ℤ) (-(S : ℤ)) b) M).det ≠ 0 ∧
      poleOrder (Frat (kacC b) d M) (kacH (R : ℤ) (-(S : ℤ)) b) = 0 := by
  have hdet : (gram (kacC b) (kacH (R : ℤ) (-(S : ℤ)) b) M).det ≠ 0 := by
    refine gram_det_ne_of_labels hK hb fun g hg heq => ?_
    obtain ⟨q1, q2, -⟩ := label_pos hg
    have hne := kacH_shift_ne hb hirr (R : ℤ) (S : ℤ) (g.1 : ℤ) (g.2 : ℤ) (by exact_mod_cast hR)
      (by exact_mod_cast hS) (by exact_mod_cast q1) (by exact_mod_cast q2)
    apply hne
    have e : kacH (R : ℤ) (S : ℤ) b + (((R : ℤ) * (S : ℤ) : ℤ) : ℂ) =
        kacH (R : ℤ) (-(S : ℤ)) b := by
      simp only [kacH]
      push_cast
      field_simp
      ring
    rw [e, ← heq, kacHL, sub_self]
  exact ⟨hdet, poleOrder_Frat_of_det hdet⟩

/-- The structure of the generic degenerate module (l.2884–2887): for generic `b` and a singular
vector `χ` of level `RS` in `M(c(b),h_{R,S}(b))`, the first Jantzen layer is `U(Vir_-)χ` and the
layers `J^i`, `i ≥ 2`, vanish.

Demand sheet: generic `b` read as `b ≠ 0`, `b² ∉ ℚ` (l.2884); `R, S ≥ 1`; every singular vector
of level `RS`; "unique proper nonzero submodule, generated by `χ`" is used in the consumer as
`J¹ = U(Vir_-)χ` (the radical of the Shapovalov form) and `J²_N = 0` at every level (two layers
in the `Δ`-Jantzen decomposition, l.2899–2901). -/
def Stmt_sub_generic_layers : Prop :=
  ∀ b : ℂ, b ≠ 0 → (∀ q : ℚ, b ^ 2 ≠ (q : ℂ)) → ∀ R S : ℕ, 0 < R → 0 < S →
    ∀ χ : Verma ℂ (kacC b) (kacH R S b), Verma.IsSingular χ (R * S) →
      jantzen (kacC b) (kacH R S b) 1 = Verma.negSpan χ ∧
      ∀ N i : ℕ, 2 ≤ i → jantzenLayer (kacC b) (kacH R S b) N i = ⊥

/-- The two-layer analogue of Proposition 11.2(i) for the generic module (l.2893–2901):
part (i) of Proposition 11.2 holds at `(c(b),h_{R,S}(b),h_{2k+1,2m+1}(b))`.

Demand sheet: generic `b`; `R, S ≥ 1`, `k < R`, `m < S` (l.2880–2881, 2893); the clauses are
those of `VertexPartI`, which the consumer uses for all layers `i` and all levels. -/
def Stmt_sub_generic_vertex : Prop :=
  ∀ b : ℂ, b ≠ 0 → (∀ q : ℚ, b ^ 2 ≠ (q : ℂ)) → ∀ R S k m : ℕ, 0 < R → 0 < S → k < R → m < S →
    VertexPartI (kacC b) (kacH R S b) (kacH (2 * (k : ℤ) + 1) (2 * (m : ℤ) + 1) b)

/-- The trace of the layer `1` (l.2899–2903): for the generic module, the trace of
`J¹_N/J²_N ≅ M(c(b),h_{R,-S}(b))_{N-RS}` is `c_{R,S}(b²;2k+1,2m+1) F_{N-RS}(c(b),h_{R,-S}(b),d)`
(the generic analogue of the layer formula of Proposition 11.2(ii), with the ratio `σ/γ` of
Theorem 9.2).

Demand sheet: as above; every `N`; every layer trace `t` of the layer `1` (`IsLayerTrace`);
multiplied by the denominator `boxDen`; the term is absent when `N < RS`. -/
def Stmt_sub_generic_layer_one : Prop :=
  ∀ b : ℂ, b ≠ 0 → (∀ q : ℚ, b ^ 2 ≠ (q : ℂ)) → ∀ R S k m : ℕ, 0 < R → 0 < S → k < R → m < S →
    ∀ (N : ℕ) (t : ℂ),
      IsLayerTrace (kacC b) (kacH R S b) (kacH (2 * (k : ℤ) + 1) (2 * (m : ℤ) + 1) b) N 1 t →
        t * boxDen R S (b ^ 2) =
          boxNum R S k m (b ^ 2) *
            (if R * S ≤ N then
              FvalAt (kacC b) (kacH (2 * (k : ℤ) + 1) (2 * (m : ℤ) + 1) b) (N - R * S)
                (kacH (R : ℤ) (-(S : ℤ)) b) else 0)

/-- `ρ_{c(b),h_{R,S}(b),d}` descends to the irreducible quotient for `d = h_{2k+1,2m+1}(b)`
(l.2893–2897: Proposition 10.2(ii) and the Ward induction). -/
theorem generic_descends (hH : Cited_HJSNormalizations) (hU : Cited_SingularUnique)
    (hF : Cited_FusionPolynomial) (hL : Stmt_sub_generic_layers) {b : ℂ} (hb : b ≠ 0)
    (hirr : ∀ q : ℚ, b ^ 2 ≠ (q : ℂ)) {R S k m : ℕ} (hR : 0 < R) (hS : 0 < S) (hk : k < R)
    (hm : m < S) :
    TorusDescends (kacC b) (kacH R S b) (kacH (2 * (k : ℤ) + 1) (2 * (m : ℤ) + 1) b) := by
  obtain ⟨p, ⟨hp1, hsing⟩, -⟩ := hH R S hR hS
  obtain ⟨-, h1, hs1, -, -⟩ := lem_regular_everywhere_of_cited hH R S hR hS p hp1 hsing b hb
  obtain ⟨hJ1, -⟩ := hL b hb hirr R S hR hS _ hs1
  have hT := Verma.isPrimaryPairing_pairing (c := kacC b) (h := kacH R S b)
    (kacH (2 * (k : ℤ) + 1) (2 * (m : ℤ) + 1) b)
  rw [torusDescends_iff hs1 hs1 (by rw [hJ1, sup_idem]) hT, and_self,
    pairing_singular_fus hH hU hF hb hR hS _ rfl _ _ hT _ hs1, fusP_roots]
  exact ⟨2 * k + 1, mem_oddsBelow.2 ⟨by omega, by omega⟩, 2 * m + 1,
    mem_oddsBelow.2 ⟨by omega, by omega⟩, by push_cast; rfl⟩

/-- Step 1 of Lemma 13.1 from its three sub-statements. -/
theorem sub_generic_tau_split_of_subs (hK : Cited_KacDeterminant) (hH : Cited_HJSNormalizations)
    (hU : Cited_SingularUnique) (hF : Cited_FusionPolynomial) (hL : Stmt_sub_generic_layers)
    (hV : Stmt_sub_generic_vertex) (hO : Stmt_sub_generic_layer_one) :
    Stmt_sub_generic_tau_split := by
  intro b hb hirr R S k m hR hS hk hm N c d
  have HV : VertexPartI c (kacH R S b) d := hV b hb hirr R S k m hR hS hk hm
  obtain ⟨p, ⟨hp1, hsing⟩, -⟩ := hH R S hR hS
  obtain ⟨-, h1, hs1, -, -⟩ := lem_regular_everywhere_of_cited hH R S hR hS p hp1 hsing b hb
  obtain ⟨-, hJ2⟩ := hL b hb hirr R S hR hS _ hs1
  obtain ⟨w, e, u, hw, hu, hd, ho⟩ :=
    exists_orth_basis (gramLocal_isSymm c (kacH R S b) N) (gramLocal_det_ne_zero c (kacH R S b) N)
  have h : OrthBasis (gramLocal c (kacH R S b) N) w e u := ⟨hw, hu, hd, ho⟩
  obtain ⟨Φ, hΦ, hΦ0⟩ := expand_Frat HV h
  obtain ⟨hp, hval⟩ := regular_of_expandAt hΦ
  refine ⟨hp, fun hle => (generic_out_regular hK hb hirr hR hS d (N - R * S)).2, fun T hT => ?_⟩
  have he : ∀ a, e a ≤ 1 := by
    intro a
    by_contra hlt
    push_neg at hlt
    have hmem : val0 w a ∈ jantzenLayer c (kacH R S b) N (e a) := by
      rw [jantzenLayer_eq_span h]
      exact Submodule.subset_span ⟨a, show e a ≤ e a from le_rfl, rfl⟩
    rw [hJ2 N (e a) hlt, Submodule.mem_bot] at hmem
    exact h.linearIndependent_val0.ne_zero a hmem
  have hsum : FvalAt c d N (kacH R S b) =
      ∑ i ∈ Finset.range 2, ∑ a : {a // e a = i}, (PowerSeries.constantCoeff (u a.1))⁻¹ *
        vform c (kacH R S b) d N i (val0 w a.1) (val0 w a.1) := by
    rw [FvalAt, hval, hΦ0, ← Finset.sum_fiberwise_of_maps_to (g := e) (t := Finset.range 2)
      (fun a _ => Finset.mem_range.2 (Nat.lt_succ_of_le (he a)))]
    refine Finset.sum_congr rfl fun i _ => ?_
    refine (Finset.sum_subtype (Finset.univ.filter fun a => e a = i) (fun x => by simp)
      (fun a => (PowerSeries.constantCoeff (u a))⁻¹ * vform c (kacH R S b) d N (e a) (val0 w a)
        (val0 w a))).trans (Finset.sum_congr rfl fun x _ => ?_)
    rw [x.2]
  have ht0 := isIrrTrace_of_layer_zero HV (isLayerTrace_orth (d := d) h 0)
  have hT0 := (irrTrace_existsUnique
    (generic_descends hH hU hF hL hb hirr hR hS hk hm) N).unique hT ht0
  have ht1 := hO b hb hirr R S k m hR hS hk hm N _ (isLayerTrace_orth (d := d) h 1)
  rw [hsum, Finset.sum_range_succ, Finset.sum_range_one, add_mul, ht1, hT0]

example (hK : Cited_KacDeterminant) (hH : Cited_HJSNormalizations) (hU : Cited_SingularUnique)
    (hF : Cited_FusionPolynomial) (hL : Stmt_sub_generic_layers) (hV : Stmt_sub_generic_vertex)
    (hO : Stmt_sub_generic_layer_one) : Stmt_sub_generic_tau_split :=
  sub_generic_tau_split_of_subs hK hH hU hF hL hV hO

end Virasoro.P2
