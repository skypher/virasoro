import Virasoro.Proofs.Crossing
import Virasoro.Proofs.Levels
import Virasoro.Proofs.GramDet
import Mathlib.Algebra.Polynomial.Taylor

/-!
# The Verma family in the internal weight and coordinate formulas

Evaluation `X ↦ h₀` from the Verma module over `K[X]` with internal weight `X` to `M(c,h₀)`;
the Shapovalov form and the primary pairing in Poincaré–Birkhoff–Witt coordinates; the Taylor
coefficients of the local Shapovalov matrix; and the factorization of the torus form on a
singular submodule over any commutative `ℚ`-algebra.
-/

namespace Virasoro

open Polynomial

section General

variable {R : Type*} [CommRing R] [Algebra ℚ R] {c h : R}

namespace Verma

/-- The Shapovalov form on level `N` in coordinates. -/
theorem shap_pbwCoord (N : ℕ) (u v : Nat.Partition N → R) :
    shap c h (pbwCoord N u) (pbwCoord N v) = gramForm c h N u v := by
  rw [gramForm, dotProduct, pbwCoord_apply, map_sum, LinearMap.sum_apply]
  refine Finset.sum_congr rfl fun Y _ => ?_
  rw [map_smul, LinearMap.smul_apply, shap_neg_pbwCoord, smul_eq_mul]

/-- A primary pairing on level `N` in coordinates. -/
theorem primary_pbwCoord {d : R} {T : Verma R c h →ₗ[R] Verma R c h →ₗ[R] R}
    (hT : IsPrimaryPairing d T) (N : ℕ) (u v : Nat.Partition N → R) :
    T (pbwCoord N u) (pbwCoord N v) = torusForm c h d N u v := by
  rw [torusForm, dotProduct, pbwCoord_apply, map_sum, LinearMap.sum_apply]
  refine Finset.sum_congr rfl fun Y _ => ?_
  rw [map_smul, LinearMap.smul_apply, smul_eq_mul, pbwCoord_apply, map_sum, Matrix.mulVec,
    dotProduct]
  congr 1
  refine Finset.sum_congr rfl fun Y' _ => ?_
  rw [map_smul, smul_eq_mul, primary_torusWord hT _ (posWord_word Y) _ (posWord_word Y'),
    mul_comm]
  rfl

/-- The torus form on the submodule generated by a vector `χ` with `L_0 χ = (h + ℓ) χ` and
`L_n χ = 0` for `n > 0`. -/
theorem singular_factorization {d : R} {T : Verma R c h →ₗ[R] Verma R c h →ₗ[R] R}
    (hT : IsPrimaryPairing d T) {χ : Verma R c h} {ℓ : ℕ} (h0 : L 0 χ = (h + (ℓ : R)) • χ)
    (hpos : ∀ n : ℤ, 0 < n → L n χ = 0) (m : ℕ) (Y Y' : Nat.Partition m) :
    T (VirEnv.negOp c Y.word • χ) (VirEnv.negOp c Y'.word • χ)
      = T χ χ * torus c (h + (ℓ : R)) d m Y Y' := by
  obtain ⟨j, hj1, hj2, hj3⟩ := exists_singularHom h0 hpos
  have hW : IsWardPairing d (T.compl₁₂ j j) := by
    intro n u v
    simp only [LinearMap.compl₁₂_apply, hj2]
    exact hT.2 n (j u) (j v)
  have := ward_torusWord hW Y.word (posWord_word Y) Y'.word (posWord_word Y')
  simp only [LinearMap.compl₁₂_apply, hj1, hj3] at this
  rw [this]
  rfl

end Verma

end General

variable {K : Type*} [Field K] [CharZero K] (c h₀ : K)

/-- Evaluation `X ↦ h₀` on the Verma family with internal weight `X`. -/
noncomputable def evX : Verma K[X] (C c) X →ₛₗ[evalRingHom h₀] Verma K c h₀ :=
  Verma.baseChange (evalRingHom h₀) (c := C c) (c' := c) (by simp) (h := X) (h' := h₀) (by simp)

theorem shap_evX (u v : Verma K[X] (C c) X) :
    Verma.shap c h₀ (evX c h₀ u) (evX c h₀ v) = (Verma.shap (C c) X u v).eval h₀ :=
  Verma.shap_baseChange (evalRingHom h₀) _ _ u v

theorem evX_pbwCoord (N : ℕ) (w : Nat.Partition N → K[X]) :
    evX c h₀ (Verma.pbwCoord N w) = Verma.pbwCoord N fun Y => (w Y).eval h₀ := by
  rw [evX, Verma.baseChange_pbwCoord]
  rfl

theorem evX_negOp_smul (w : List ℕ) (v : Verma K[X] (C c) X) :
    evX c h₀ (VirEnv.negOp (C c) w • v) = VirEnv.negOp c w • evX c h₀ v :=
  Verma.baseChange_negOp_smul (evalRingHom h₀) _ _ w v

theorem evX_eq_zero (u : Verma K[X] (C c) X) (hu : evX c h₀ u = 0) :
    ∃ ψ : Verma K[X] (C c) X, u = (X - C h₀) • ψ := by
  refine Verma.baseChange_eq_zero (evalRingHom h₀) _ _ (π := X - C h₀) ?_ u hu
  intro a ha
  obtain ⟨b, hb⟩ := dvd_iff_isRoot.2 (show IsRoot a h₀ from ha)
  exact ⟨b, hb⟩

/-- The shift `p(h + x)` is the Taylor expansion of `p` at `h`. -/
theorem shiftPS_eq_taylor (p : K[X]) :
    shiftPS h₀ p = ((taylor h₀ p : K[X]) : PowerSeries K) := by
  have key : shiftPS h₀
      = (Polynomial.coeToPowerSeries.ringHom (R := K)).comp
          ((taylorAlgHom h₀ : K[X] →ₐ[K] K[X]) : K[X] →+* K[X]) := by
    apply Polynomial.ringHom_ext
    · intro a
      rw [shiftPS_C]
      simp [Polynomial.coeToPowerSeries.ringHom]
    · rw [shiftPS_X]
      simp [Polynomial.coeToPowerSeries.ringHom, add_comm]
  rw [key]
  rfl

theorem coeff_zero_shiftPS (p : K[X]) : PowerSeries.coeff 0 (shiftPS h₀ p) = p.eval h₀ := by
  rw [shiftPS_eq_taylor, Polynomial.coeff_coe, taylor_coeff_zero]

theorem coeff_one_shiftPS (p : K[X]) :
    PowerSeries.coeff 1 (shiftPS h₀ p) = (derivative p).eval h₀ := by
  rw [shiftPS_eq_taylor, Polynomial.coeff_coe, taylor_coeff_one]

theorem coeffMat_zero_gramLocal (N : ℕ) : coeffMat 0 (gramLocal c h₀ N) = gram c h₀ N := by
  ext Y Y'
  rw [coeffMat, Matrix.map_apply, gramLocal_eq_map, Matrix.map_apply, coeff_zero_shiftPS]
  have := gram_map (Polynomial.evalRingHom h₀) (C c) (X : K[X]) N
  simp only [coe_evalRingHom, eval_C, eval_X] at this
  rw [this]
  rfl

theorem coeffMat_one_gramLocal (N : ℕ) (Y Y' : Nat.Partition N) :
    coeffMat 1 (gramLocal c h₀ N) Y Y' = (derivative (gramPoly c N Y Y')).eval h₀ := by
  rw [coeffMat, Matrix.map_apply, gramLocal_eq_map, Matrix.map_apply, coeff_one_shiftPS]

end Virasoro
