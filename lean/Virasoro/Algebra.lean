import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.RingQuot
import Mathlib.Algebra.Algebra.Rat
import Mathlib.Algebra.Module.Submodule.Basic
import Mathlib.LinearAlgebra.Quotient.Defs
import Mathlib.LinearAlgebra.Span.Defs
import Mathlib.Combinatorics.Enumerative.Partition.Basic
import Mathlib.Data.Multiset.Sort
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.LinearAlgebra.Pi

/-!
# The Virasoro algebra and its Verma modules (paper Definition 2.1)

For a commutative `ℚ`-algebra `R` and `c : R`, `VirEnv R c` is the associative `R`-algebra
generated by symbols `L n` (`n : ℤ`) subject to
`L m * L n - L n * L m = (m - n) L (m+n) + c/12 (m^3 - m) δ_{m+n,0}`,
that is, the universal enveloping algebra of the Virasoro algebra with the central element
specialised to the scalar `c`.  The Verma module `Verma R c h` is the quotient of `VirEnv R c`
by the left ideal generated by `L n` (`n > 0`) and `L 0 - h`: it is generated by the vector
`Verma.hw = |h⟩` with `L 0 |h⟩ = h |h⟩` and `L n |h⟩ = 0` for `n > 0`.
-/

namespace Virasoro

open FreeAlgebra

variable (R : Type*) [CommRing R] [Algebra ℚ R]

/-- The central term `c/12 (m^3 - m)` of the Virasoro commutator. -/
def centralTerm {R : Type*} [CommRing R] [Algebra ℚ R] (c : R) (m : ℤ) : R :=
  algebraMap ℚ R (((m ^ 3 - m : ℤ) : ℚ) / 12) * c

/-- The defining relations of the Virasoro algebra at central charge `c`:
`L m L n = L n L m + (m - n) L (m+n) + c/12 (m^3 - m) δ_{m+n,0}`. -/
inductive VirRel (c : R) : FreeAlgebra R ℤ → FreeAlgebra R ℤ → Prop
  | comm (m n : ℤ) :
      VirRel c (ι R m * ι R n)
        (ι R n * ι R m + ((m - n : ℤ) : R) • ι R (m + n)
          + (if m + n = 0 then algebraMap R (FreeAlgebra R ℤ) (centralTerm c m) else 0))

/-- The enveloping algebra of the Virasoro algebra with central element acting as `c`. -/
abbrev VirEnv (c : R) : Type _ := RingQuot (VirRel R c)

namespace VirEnv

variable {R}

/-- The generator `L n` of the Virasoro algebra. -/
noncomputable def L (c : R) (n : ℤ) : VirEnv R c :=
  RingQuot.mkAlgHom R (VirRel R c) (ι R n)

/-- The Virasoro commutation relation in `VirEnv R c`. -/
theorem L_mul_L (c : R) (m n : ℤ) :
    L c m * L c n = L c n * L c m + ((m - n : ℤ) : R) • L c (m + n)
      + (if m + n = 0 then algebraMap R (VirEnv R c) (centralTerm c m) else 0) := by
  have h := RingQuot.mkAlgHom_rel R (VirRel.comm (R := R) (c := c) m n)
  simp only [map_mul, map_add, map_smul] at h
  rw [show L c m * L c n = (RingQuot.mkAlgHom R (VirRel R c)) (ι R m) *
      (RingQuot.mkAlgHom R (VirRel R c)) (ι R n) from rfl, h]
  congr 1
  split_ifs
  · exact (AlgHom.commutes _ _)
  · exact map_zero _

/-- The product `L_{-w₁} ⋯ L_{-w_r}` attached to a word `w = [w₁, …, w_r]`. -/
noncomputable def negOp (c : R) (w : List ℕ) : VirEnv R c :=
  (w.map fun y => L c (-(y : ℤ))).prod

/-- The product `L_Y = L_{y_ℓ} ⋯ L_{y₁}` attached to a word `Y = [y₁, …, y_ℓ]`. -/
noncomputable def posOp (c : R) (w : List ℕ) : VirEnv R c :=
  (w.reverse.map fun y => L c (y : ℤ)).prod

end VirEnv

/-- The left ideal of `VirEnv R c` generated by `L n` (`n > 0`) and `L 0 - h`. -/
def hwIdeal (c h : R) : Submodule (VirEnv R c) (VirEnv R c) :=
  Submodule.span (VirEnv R c)
    ({x | ∃ n : ℤ, 0 < n ∧ x = VirEnv.L c n} ∪ {VirEnv.L c 0 - algebraMap R (VirEnv R c) h})

/-- The Verma module `M(c,h)` (paper Definition 2.1). -/
abbrev Verma (c h : R) : Type _ := VirEnv R c ⧸ hwIdeal R c h

namespace Verma

variable {R} {c h : R}

/-- The highest-weight vector `|h⟩`. -/
def hw : Verma R c h := Submodule.Quotient.mk 1

/-- The mode `L n` as an `R`-linear endomorphism of the Verma module. -/
noncomputable def L (n : ℤ) : Verma R c h →ₗ[R] Verma R c h where
  toFun v := VirEnv.L c n • v
  map_add' := smul_add _
  map_smul' r v := (smul_comm r (VirEnv.L c n) v).symm

/-- The Poincaré–Birkhoff–Witt vector `L_{-w₁} ⋯ L_{-w_r} |h⟩` of a word `w`. -/
noncomputable def neg (w : List ℕ) : Verma R c h := VirEnv.negOp c w • hw

end Verma

end Virasoro

namespace Nat.Partition

/-- The parts of a partition in weakly decreasing order: the word `(y₁ ≥ ⋯ ≥ y_ℓ)` of the
Poincaré–Birkhoff–Witt monomial `L_{-Y} = L_{-y₁} ⋯ L_{-y_ℓ}`. -/
def word {N : ℕ} (Y : Nat.Partition N) : List ℕ := Y.parts.sort (· ≥ ·)

end Nat.Partition

namespace Virasoro

variable {R : Type*} [CommRing R] [Algebra ℚ R] {c h : R}

namespace Verma

/-- The coordinate map of level `N`: a coefficient vector `v` indexed by partitions of `N` is sent
to `∑_Y v_Y L_{-Y} |h⟩`. -/
noncomputable def pbwCoord (N : ℕ) : (Nat.Partition N → R) →ₗ[R] Verma R c h :=
  ∑ Y : Nat.Partition N,
    (LinearMap.proj (R := R) (φ := fun _ : Nat.Partition N => R) Y).smulRight
      (neg (c := c) (h := h) Y.word)

/-- The level-`N` subspace of the Verma module, spanned by the vectors `L_{-Y}|h⟩`, `|Y| = N`. -/
noncomputable def level (N : ℕ) : Submodule R (Verma R c h) := LinearMap.range (pbwCoord N)

/-- A linear functional `ε` is the vacuum functional `⟨h|` if `⟨h|h⟩ = 1` and
`⟨h| L_{-n} = 0` for all `n > 0`. -/
def IsVacuumFunctional (ε : Verma R c h →ₗ[R] R) : Prop :=
  ε hw = 1 ∧ ∀ n : ℤ, n < 0 → ∀ v, ε (L n v) = 0

/-- A bilinear form on the Verma module is the Shapovalov form if `⟨h|h⟩ = 1` and it is
contravariant: `⟨L_n u, v⟩ = ⟨u, L_{-n} v⟩`. -/
def IsShapovalov (B : Verma R c h →ₗ[R] Verma R c h →ₗ[R] R) : Prop :=
  B hw hw = 1 ∧ ∀ (n : ℤ) (u v : Verma R c h), B (L n u) v = B u (L (-n) v)

/-- Matrix elements `T(u,v) = ⟨u| V_d(1) |v⟩` of a primary field of weight `d`, normalised by
`⟨h|V_d(z)|h⟩ = z^{-d}`.  The commutator `[L_n, V_d(z)] = z^n (z ∂_z + (n+1) d) V_d(z)` gives, for
`L_0`-eigenvectors `u, v`, `⟨u|V_d(z)|v⟩ = T(u,v) z^{wt u - wt v - d}`, and at `z = 1` the Ward
identity `T(L_{-n} u, v) - T(u, L_n v) = T(L_0 u, v) - T(u, L_0 v) + n d T(u, v)`. -/
def IsPrimaryPairing (d : R) (T : Verma R c h →ₗ[R] Verma R c h →ₗ[R] R) : Prop :=
  T hw hw = 1 ∧ ∀ (n : ℤ) (u v : Verma R c h),
    T (L (-n) u) v - T u (L n v) = T (L 0 u) v - T u (L 0 v) + (n : R) * d * T u v

/-- `χ` is a singular vector of level `ℓ`: nonzero, of `L_0`-weight `h + ℓ`, and annihilated by
all positive modes. -/
def IsSingular (χ : Verma R c h) (ℓ : ℕ) : Prop :=
  χ ≠ 0 ∧ L 0 χ = (h + (ℓ : R)) • χ ∧ ∀ n : ℤ, 0 < n → L n χ = 0

/-- The submodule `U(Vir_-) χ` spanned by the vectors `L_{-w₁} ⋯ L_{-w_r} χ`. -/
noncomputable def negSpan (χ : Verma R c h) : Submodule R (Verma R c h) :=
  Submodule.span R (Set.range fun w : List ℕ+ => VirEnv.negOp c (w.map (↑)) • χ)

/-- A submodule of the Verma module that is stable under every mode `L n`. -/
def IsVirSubmodule (W : Submodule R (Verma R c h)) : Prop :=
  ∀ (n : ℤ) (v : Verma R c h), v ∈ W → L n v ∈ W

end Verma

/-- Explicit vectors: a list of (word, coefficient) pairs stands for `∑ a • L_{-w}|h⟩`. -/
abbrev St (R : Type*) := List (List ℕ × R)

/-- The vector of the Verma module represented by a list of (word, coefficient) pairs. -/
noncomputable def St.toVerma (s : St R) : Verma R c h :=
  (s.map fun t => t.2 • Verma.neg (c := c) (h := h) t.1).sum

/-- The level-`N` coordinates of a list of (word, coefficient) pairs whose words are weakly
decreasing: the coefficient of `L_{-Y}|h⟩` is the sum of the coefficients attached to `Y.word`. -/
def St.coords (N : ℕ) (s : St R) : Nat.Partition N → R :=
  fun Y => ((s.filter fun t => t.1 = Y.word).map Prod.snd).sum

end Virasoro
