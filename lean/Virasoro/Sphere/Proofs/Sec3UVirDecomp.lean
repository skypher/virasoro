import Virasoro.Sphere.Proofs.Sec3UVir
import Virasoro.Sphere.Proofs.Sec3WardBlock
import Mathlib.LinearAlgebra.Matrix.ToLinearEquiv

/-!
# The orthogonal decomposition of a unitary representation (sphere paper, Lemma 3.7, Step 1)

sphere/paper.tex l.1053–1060: the space decomposes orthogonally into the modules generated by
its primary vectors.  By induction on the level `N`: the descendants of the primaries of levels
`n < N` span a subspace of level `N` whose orthogonal complement in level `N` is the primary
space of level `N`.
-/

namespace Virasoro.Sphere

namespace UVir

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (R : UVir V)

/-- The primary space of level `n`: `{P ∈ V_n : L_k P = 0 for k ≥ 1}`. -/
noncomputable def prim (n : ℕ) : Submodule ℂ V :=
  R.lev n ⊓ ⨅ k ∈ Finset.Icc 1 n, LinearMap.ker (R.L (k : ℤ))

theorem mem_prim {n : ℕ} {P : V} :
    P ∈ R.prim n ↔ P ∈ R.lev n ∧ ∀ k : ℕ, 1 ≤ k → k ≤ n → R.L (k : ℤ) P = 0 := by
  simp only [prim, Submodule.mem_inf, Submodule.mem_iInf, Finset.mem_Icc, LinearMap.mem_ker,
    and_imp]

theorem prim_isHW {n : ℕ} {P : V} (hP : P ∈ R.prim n) : R.IsHW P ((R.h0 : ℂ) + (n : ℂ)) := by
  obtain ⟨h1, h2⟩ := R.mem_prim.mp hP
  refine ⟨fun k hk => ?_, R.L_zero n P h1⟩
  obtain ⟨k', rfl⟩ : ∃ k' : ℕ, k = (k' : ℤ) := ⟨k.toNat, by omega⟩
  by_cases hkn : k' ≤ n
  · exact h2 k' (by omega) hkn
  · exact R.L_kill k' n P (by omega) h1

theorem wordOp_mem_lev {m : ℕ} {x : V} (hx : x ∈ R.lev m) :
    ∀ (w : List ℕ) (N : ℕ), m + w.sum = N → R.wordOp w x ∈ R.lev N
  | [], N, h => by
    rw [List.sum_nil, add_zero] at h
    subst h
    exact hx
  | y :: w, N, h => by
    rw [List.sum_cons] at h
    have h1 := R.L_raise y (m + w.sum) _ (wordOp_mem_lev hx w _ rfl)
    have e : m + w.sum + y = N := by omega
    rw [e] at h1
    exact h1

/-- The Gram matrix of a linearly independent family is invertible. -/
theorem gramF_det_ne_zero {ι : Type*} [Fintype ι] [DecidableEq ι] (e : ι → V)
    (he : LinearIndependent ℂ e) :
    (Matrix.of fun i j => R.form (e i) (e j)).det ≠ 0 := by
  intro hdet
  obtain ⟨v, hv, hGv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  have hu : R.form (∑ j, v j • e j) (∑ j, v j • e j) = 0 := by
    rw [form_sum_left]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [form_smul_left, form_sum_right]
    have h1 := congrFun hGv i
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply] at h1
    have h2 : ∑ j, R.form (e i) (v j • e j) = 0 :=
      (Finset.sum_congr rfl fun j _ => by rw [R.form_smul_right, mul_comm]).trans h1
    rw [h2, mul_zero]
  have h0 := R.form_def _ hu
  exact hv (funext fun i => Fintype.linearIndependent_iff.mp he v h0 i)

/-- Orthogonal projection onto a finite-dimensional subspace. -/
theorem exists_proj (W : Submodule ℂ V) [Module.Finite ℂ W] (x : V) :
    ∃ w ∈ W, ∀ y ∈ W, R.form y (x - w) = 0 := by
  classical
  let b := Module.finBasis ℂ W
  let e : Fin (Module.finrank ℂ W) → V := fun i => (b i : V)
  have he : LinearIndependent ℂ e :=
    b.linearIndependent.map' W.subtype (Submodule.ker_subtype W)
  have hG := R.gramF_det_ne_zero e he
  let t := (Matrix.of fun i j => R.form (e i) (e j))⁻¹.mulVec (fun i => R.form (e i) x)
  have ht : (Matrix.of fun i j => R.form (e i) (e j)).mulVec t = fun i => R.form (e i) x := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hG),
      Matrix.one_mulVec]
  refine ⟨∑ j, t j • e j, Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (b j).2, ?_⟩
  have hb : ∀ i, R.form (e i) (x - ∑ j, t j • e j) = 0 := by
    intro i
    rw [form_sub_right, form_sum_right, sub_eq_zero]
    have h1 := congrFun ht i
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply] at h1
    rw [← h1]
    exact Finset.sum_congr rfl fun j _ => by rw [R.form_smul_right, mul_comm]
  intro y hy
  have hy' : y = ∑ i, b.repr ⟨y, hy⟩ i • e i := by
    have h2 := congrArg W.subtype (b.sum_repr ⟨y, hy⟩)
    rw [map_sum] at h2
    simpa [e] using h2.symm
  rw [hy', form_sum_left]
  exact Finset.sum_eq_zero fun i _ => by rw [form_smul_left, hb, mul_zero]

/-- The vectors `y` with `⟨y, z⟩ = 0`. -/
def orthTo (z : V) : Submodule ℂ V where
  carrier := {y | R.form y z = 0}
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at *
    rw [form_add_left, ha, hb, add_zero]
  zero_mem' := form_zero_left R z
  smul_mem' := by
    intro c a ha
    simp only [Set.mem_setOf_eq] at *
    rw [form_smul_left, ha, mul_zero]

/-- The level-`N` descendants of the primaries of level `n`. -/
noncomputable def desc (n N : ℕ) : Submodule ℂ V :=
  Submodule.span ℂ
    {v | ∃ P ∈ R.prim n, ∃ w : List ℕ, PosWord w ∧ n + w.sum = N ∧ v = R.wordOp w P}

theorem desc_le_lev (n N : ℕ) : R.desc n N ≤ R.lev N :=
  Submodule.span_le.mpr (by
    rintro v ⟨P, hP, w, -, hN, rfl⟩
    exact R.wordOp_mem_lev (R.mem_prim.mp hP).1 w N hN)

/-- Level `N` is spanned by the descendants of the primaries of levels `n ≤ N`
(sphere/paper.tex l.1053–1055). -/
theorem lev_le_sup : ∀ N : ℕ, R.lev N ≤ ⨆ n ∈ Finset.range (N + 1), R.desc n N := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro x hx
    have hWle : (⨆ n ∈ Finset.range N, R.desc n N) ≤ R.lev N :=
      iSup₂_le fun n _ => R.desc_le_lev n N
    haveI := R.lev_fin N
    haveI : Module.Finite ℂ (⨆ n ∈ Finset.range N, R.desc n N : Submodule ℂ V) :=
      Submodule.finiteDimensional_of_le hWle
    obtain ⟨w, hw, horth⟩ := R.exists_proj (⨆ n ∈ Finset.range N, R.desc n N) x
    have hmono : (⨆ n ∈ Finset.range N, R.desc n N) ≤
        ⨆ n ∈ Finset.range (N + 1), R.desc n N := by
      refine iSup₂_le fun n hn => ?_
      exact le_iSup₂_of_le n
        (Finset.mem_range.2 (by have := Finset.mem_range.1 hn; omega)) le_rfl
    have hxw : x - w ∈ R.lev N := Submodule.sub_mem _ hx (hWle hw)
    have hprim : x - w ∈ R.prim N := by
      refine R.mem_prim.mpr ⟨hxw, fun k hk hkN => ?_⟩
      have hz : R.L (k : ℤ) (x - w) ∈ R.lev (N - k) :=
        R.L_lower k (N - k) _ (by rw [Nat.sub_add_cancel hkN]; exact hxw)
      apply R.form_def
      have hle : (⨆ n ∈ Finset.range (N - k + 1), R.desc n (N - k)) ≤
          R.orthTo (R.L (k : ℤ) (x - w)) := by
        refine iSup₂_le fun n hn => Submodule.span_le.mpr ?_
        rintro v ⟨P, hP, w', hw', hN, rfl⟩
        show R.form (R.wordOp w' P) (R.L (k : ℤ) (x - w)) = 0
        have h1 := R.adj (-(k : ℤ)) (R.wordOp w' P) (x - w)
        rw [neg_neg] at h1
        rw [← h1]
        apply horth
        have hn' := Finset.mem_range.1 hn
        refine Submodule.mem_iSup_of_mem n (Submodule.mem_iSup_of_mem
          (Finset.mem_range.2 (by omega)) (Submodule.subset_span
            ⟨P, hP, k :: w', ?_, ?_, rfl⟩))
        · intro y hy
          rcases List.mem_cons.mp hy with rfl | h
          · exact hk
          · exact hw' y h
        · rw [List.sum_cons]
          omega
      exact hle (ih (N - k) (by omega) hz)
    have hx' : x = w + (x - w) := by abel
    rw [hx']
    refine Submodule.add_mem _ (hmono hw) ?_
    exact Submodule.mem_iSup_of_mem N (Submodule.mem_iSup_of_mem
      (Finset.mem_range.2 (Nat.lt_succ_self N)) (Submodule.subset_span
        ⟨x - w, hprim, [], by intro y hy; simp at hy, by simp, rfl⟩))

/-! ### Ward families -/

/-- A solution of the Ward equations `L_k F = (L_0 + kΔ_b - Δ_a)F`, `k ≥ 1`, with `F_m` of
level `m`. -/
structure IsWard (Δa Δb : ℝ) (F : ℕ → V) : Prop where
  mem : ∀ m, F m ∈ R.lev m
  ward : ∀ k : ℕ, 1 ≤ k → ∀ m : ℕ,
    R.L (k : ℤ) (F (m + k)) = R.L 0 (F m) + ((k : ℂ) * (Δb : ℂ) - (Δa : ℂ)) • F m

variable {R}

/-- `⟨L_{-w}P, F_N⟩ = γ_w ⟨P, F_n⟩` for a primary `P` of level `n` (sphere/paper.tex
l.1060–1063: the Ward equations determine the descendant projections from the primary
component). -/
theorem ward_pair {Δa Δb : ℝ} {F : ℕ → V} (hF : R.IsWard Δa Δb F) {n : ℕ} {P : V}
    (hP : P ∈ R.prim n) : ∀ (w : List ℕ), PosWord w → ∀ N : ℕ, n + w.sum = N →
    R.form (R.wordOp w P) (F N) =
      gammaY ((R.h0 : ℂ) + (n : ℂ)) (Δa : ℂ) (Δb : ℂ) w * R.form P (F n)
  | [], _, N, hN => by
    rw [List.sum_nil, add_zero] at hN
    subst hN
    simp [gammaY, wordOp_nil]
  | y :: w, hw, N, hN => by
    have hy : 1 ≤ y := hw y List.mem_cons_self
    have hw' : PosWord w := fun z hz => hw z (List.mem_cons_of_mem _ hz)
    obtain rfl : N = n + w.sum + y := by
      rw [List.sum_cons] at hN
      omega
    have h1 := R.adj (-(y : ℤ)) (R.wordOp w P) (F (n + w.sum + y))
    rw [neg_neg] at h1
    rw [wordOp_cons, h1, hF.ward y hy, R.L_zero _ _ (hF.mem _), R.form_add_right,
      R.form_smul_right, R.form_smul_right, ward_pair hF hP w hw' _ rfl]
    show _ = ((R.h0 : ℂ) + (n : ℂ) + ((w.sum : ℕ) : ℂ) + (y : ℂ) * (Δb : ℂ) - (Δa : ℂ)) *
      gammaY ((R.h0 : ℂ) + (n : ℂ)) (Δa : ℂ) (Δb : ℂ) w * R.form P (F n)
    push_cast
    ring

end UVir

end Virasoro.Sphere
