import Virasoro.Sphere.Proofs.Sec3C2GaussNorm
import Virasoro.Sphere.Proofs.Sec3C2Steps

/-!
# Lemma 3.7, Step 1: the exact `c = 2` decomposition (3.8) (sphere paper)

sphere/paper.tex l.1047–1071.  `F_tot = F_1F_2` solves the `c = 2`, `Δ₁ = Δ₂ = 1/8` Ward
equation; at `c = 2` every Verma module `M(2, λ²+n)` is Kac-nonresonant; orthogonal projection
to the modules generated by the primaries gives (3.8).
-/

namespace Virasoro.Sphere

open TensorProduct Finset

/-! ### Kac nonresonance at `c = 2` -/

open Polynomial in
/-- At `c = 2` every Kac weight is nonpositive or nonreal, so `det G_N(2, h) ≠ 0` for real
`h > 0` (sphere/paper.tex l.1050–1053, as in the proof of Lemma 3.2(i)). -/
theorem gram_det_ne_zero_c2 (hK : Cited_KacDeterminant) (h : ℝ) (hh : 0 < h) (N : ℕ) :
    (gram (2 : ℂ) (h : ℂ) N).det ≠ 0 := by
  have hμ2 : Real.sqrt (1 / 24) ^ 2 = 1 / 24 := Real.sq_sqrt (by norm_num)
  have hμ0 : 0 < Real.sqrt (1 / 24) := Real.sqrt_pos.mpr (by norm_num)
  generalize Real.sqrt (1 / 24) = μ at hμ2 hμ0
  have hpos : 0 < 1 - μ ^ 2 := by
    rw [hμ2]
    norm_num
  have hw : Real.sqrt (1 - μ ^ 2) ^ 2 = 1 - μ ^ 2 := Real.sq_sqrt hpos.le
  have hw0 : 0 < Real.sqrt (1 - μ ^ 2) := Real.sqrt_pos.mpr hpos
  generalize Real.sqrt (1 - μ ^ 2) = w at hw hw0
  have hb1 : (⟨μ, w⟩ : ℂ) * ⟨μ, -w⟩ = 1 := by
    apply Complex.ext
    · simp only [Complex.mul_re, Complex.one_re]
      nlinarith
    · simp only [Complex.mul_im, Complex.one_im]
      ring
  have hb2 : (⟨μ, w⟩ : ℂ) + ⟨μ, -w⟩ = 2 * (μ : ℂ) := by
    apply Complex.ext <;> simp <;> ring
  have hb : (⟨μ, w⟩ : ℂ) ≠ 0 := left_ne_zero_of_mul_eq_one hb1
  have hinv : (⟨μ, w⟩ : ℂ)⁻¹ = ⟨μ, -w⟩ := (eq_inv_of_mul_eq_one_right hb1).symm
  have hμc : (μ : ℂ) ^ 2 = 1 / 24 := by
    rw [← Complex.ofReal_pow, hμ2]
    push_cast
    ring
  have hc : kacC (⟨μ, w⟩ : ℂ) = 2 := by
    have h1 : kacC (⟨μ, w⟩ : ℂ) = 1 + 24 * (μ : ℂ) ^ 2 := by
      rw [kacC, hinv, hb2]
      ring
    rw [h1, hμc]
    norm_num
  obtain ⟨C₀, hC, hdet⟩ := hK _ hb N
  rw [← gramPoly_det_eval, ← hc, hdet, eval_mul, eval_C, eval_prod]
  refine mul_ne_zero hC (Finset.prod_ne_zero_iff.mpr fun a ha => ?_)
  rw [eval_pow, eval_sub, eval_X, eval_C]
  refine pow_ne_zero _ fun h0 => ?_
  obtain ⟨hr, hs⟩ := labels_pos ha
  have h1 : kacHL a (⟨μ, w⟩ : ℂ) =
      ((2 * (μ : ℂ)) ^ 2 - ((a.1 : ℂ) * ⟨μ, w⟩ + (a.2 : ℂ) * ⟨μ, -w⟩) ^ 2) / 4 := by
    rw [kacHL, kacH, hinv, hb2]
    push_cast
    rfl
  have hxy : (a.1 : ℂ) * (⟨μ, w⟩ : ℂ) + (a.2 : ℂ) * ⟨μ, -w⟩ =
      ⟨((a.1 : ℝ) + a.2) * μ, ((a.1 : ℝ) - a.2) * w⟩ := by
    apply Complex.ext <;> simp <;> ring
  rw [h1, hxy] at h0
  have h2 : (⟨((a.1 : ℝ) + a.2) * μ, ((a.1 : ℝ) - a.2) * w⟩ : ℂ) *
      ⟨((a.1 : ℝ) + a.2) * μ, ((a.1 : ℝ) - a.2) * w⟩ = ((4 * μ ^ 2 - 4 * h : ℝ) : ℂ) := by
    push_cast
    linear_combination (4 : ℂ) * h0
  have hre := congrArg Complex.re h2
  have him := congrArg Complex.im h2
  simp only [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im] at hre him
  have hr' : (0 : ℝ) < a.1 := by exact_mod_cast hr
  have hs' : (0 : ℝ) < a.2 := by exact_mod_cast hs
  have hr1 : (1 : ℝ) ≤ a.1 := by exact_mod_cast hr
  have hrs : ((a.1 : ℝ) - a.2) = 0 := by
    have h3 : ((a.1 : ℝ) + a.2) * μ * (((a.1 : ℝ) - a.2) * w) = 0 := by nlinarith
    rcases mul_eq_zero.mp h3 with h4 | h4
    · exact absurd h4 (by positivity)
    · rcases mul_eq_zero.mp h4 with h5 | h5
      · exact h5
      · exact absurd h5 hw0.ne'
  have hs_eq : (a.2 : ℝ) = a.1 := by linarith
  rw [hrs, hs_eq] at hre
  have h5 : (1 : ℝ) ≤ (a.1 : ℝ) * (a.1 : ℝ) := by nlinarith
  have h6 : 0 ≤ ((a.1 : ℝ) * (a.1 : ℝ) - 1) * (μ * μ) :=
    mul_nonneg (by linarith) (mul_self_nonneg μ)
  nlinarith

theorem gram_det_ne_zero_hh (hK : Cited_KacDeterminant) (lam : ℝ) (hlam : 0 < lam) (n M : ℕ) :
    (gram (((2 : ℝ)) : ℂ) (((lam ^ 2 : ℝ) : ℂ) + (n : ℂ)) M).det ≠ 0 := by
  have h := gram_det_ne_zero_c2 hK (lam ^ 2 + n) (by positivity) M
  have e : (((lam ^ 2 + n : ℝ)) : ℂ) = ((lam ^ 2 : ℝ) : ℂ) + (n : ℂ) := by push_cast; ring
  rw [e] at h
  have e2 : (((2 : ℝ)) : ℂ) = 2 := by norm_num
  rw [e2]
  exact h

/-! ### `F_tot` -/

theorem Ftot_eq_range (lam : ℂ) (N : ℕ) :
    Ftot lam N = ∑ i ∈ range (N + 1), gaussF lam i ⊗ₜ[ℂ] gaussF 0 (N - i) :=
  Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk
    (fun p : ℕ × ℕ => gaussF lam p.1 ⊗ₜ[ℂ] gaussF 0 p.2) N

theorem Ftot_mem_level (lam : ℂ) (N : ℕ) : Ftot lam N ∈ hhLevel N := by
  rw [Ftot_eq_range]
  refine Submodule.sum_mem _ fun i hi => ?_
  have h := tmul_mem_hhLevel (gaussF_mem_level lam i) (gaussF_mem_level 0 (N - i))
  have e : i + (N - i) = N := by
    have := Finset.mem_range.1 hi
    omega
  rwa [e] at h

/-- `F_tot = F_1F_2` solves `L_k^tot F_tot = (L_0^tot + (k-1)/8) F_tot`
(sphere/paper.tex l.1047–1049). -/
theorem Ftot_ward (lam : ℂ) (k : ℕ) (hk : 1 ≤ k) (m : ℕ) :
    Ltot lam (k : ℤ) (Ftot lam (m + k)) =
      Ltot lam 0 (Ftot lam m) + ((k : ℂ) * (1 / 8) - 1 / 8) • Ftot lam m := by
  have h1 := (gaussF_ward lam).2.2 k hk
  have h2 := (gaussF_ward 0).2.2 k hk
  have hA : ∑ i ∈ range (m + k + 1),
      ffOp 0 lam (k : ℤ) (gaussF lam i) ⊗ₜ[ℂ] gaussF 0 (m + k - i) =
      ∑ j ∈ range (m + 1), (ffOp 0 lam 0 (gaussF lam j) +
        MvPolynomial.C ((k : ℂ) * (1 / 16) - 1 / 16) * gaussF lam j) ⊗ₜ[ℂ] gaussF 0 (m - j) := by
    rw [show m + k + 1 = k + (m + 1) by omega, Finset.sum_range_add, Finset.sum_eq_zero,
      zero_add]
    · refine Finset.sum_congr rfl fun j _ => ?_
      rw [show k + j = j + k by omega, h1 j, show m + k - (j + k) = m - j by omega]
    · intro i hi
      rw [ffOp_pos_kill 0 lam (Finset.mem_range.1 hi) (gaussF_mem_level lam i),
        TensorProduct.zero_tmul]
  have hB : ∑ i ∈ range (m + k + 1),
      gaussF lam i ⊗ₜ[ℂ] ffOp 0 0 (k : ℤ) (gaussF 0 (m + k - i)) =
      ∑ i ∈ range (m + 1), gaussF lam i ⊗ₜ[ℂ] (ffOp 0 0 0 (gaussF 0 (m - i)) +
        MvPolynomial.C ((k : ℂ) * (1 / 16) - 1 / 16) * gaussF 0 (m - i)) := by
    rw [← Finset.sum_subset (Finset.range_mono (by omega : m + 1 ≤ m + k + 1)) (fun i hi hni => by
      rw [Finset.mem_range] at hi hni
      rw [ffOp_pos_kill 0 0 (m := m + k - i) (by omega) (gaussF_mem_level 0 (m + k - i)),
        TensorProduct.tmul_zero])]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.mem_range] at hi
    rw [show m + k - i = (m - i) + k by omega, h2 (m - i)]
  rw [Ftot_eq_range, Ftot_eq_range, map_sum, map_sum, Finset.smul_sum]
  simp only [Ltot_tmul]
  rw [Finset.sum_add_distrib, hA, hB, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hc : ((k : ℂ) * (1 / 8) - 1 / 8) =
      ((k : ℂ) * (1 / 16) - 1 / 16) + ((k : ℂ) * (1 / 16) - 1 / 16) := by ring
  rw [hc, MvPolynomial.C_mul', MvPolynomial.C_mul']
  simp only [TensorProduct.add_tmul, TensorProduct.tmul_add, ← TensorProduct.smul_tmul',
    TensorProduct.tmul_smul]
  module

section Cited

variable (hF : Cited_FeiginFuchsOperators)

theorem Ftot_isWard (lam : ℝ) : (hhUVir hF lam).IsWard (1 / 8) (1 / 8) (Ftot (lam : ℂ)) where
  mem := fun m => Ftot_mem_level (lam : ℂ) m
  ward := fun k hk m => by
    have h := Ftot_ward (lam : ℂ) k hk m
    have e8 : (((1 / 8 : ℝ)) : ℂ) = 1 / 8 := by norm_num
    rw [e8]
    exact h

include hF in
/-- `⟨F_tot,N, F_tot,N⟩` is the coefficient of `z^N` of `G_charged G_neutral`
(sphere/paper.tex l.1035–1045). -/
theorem Ftot_norm (lam : ℝ) (N : ℕ) :
    hhForm (Ftot (lam : ℂ) N) (Ftot (lam : ℂ) N) =
      PowerSeries.coeff N (detInvSqrt.map (algebraMap ℚ ℂ) * EI ((lam : ℂ) ^ 2) *
        detInvSqrt.map (algebraMap ℚ ℂ)) := by
  have hsl : ∀ (s : Finset (ℕ × ℕ)) (f : ℕ × ℕ → HH) (g : HH),
      hhForm (∑ p ∈ s, f p) g = ∑ p ∈ s, hhForm (f p) g :=
    fun s f g => (hhUVir hF lam).form_sum_left s f g
  have hsr : ∀ (s : Finset (ℕ × ℕ)) (f : HH) (g : ℕ × ℕ → HH),
      hhForm f (∑ p ∈ s, g p) = ∑ p ∈ s, hhForm f (g p) :=
    fun s f g => (hhUVir hF lam).form_sum_right s f g
  have e : detInvSqrt.map (algebraMap ℚ ℂ) * EI ((lam : ℂ) ^ 2) *
      detInvSqrt.map (algebraMap ℚ ℂ) =
      (EI ((lam : ℂ) ^ 2) * detInvSqrt.map (algebraMap ℚ ℂ)) *
        (EI 0 * detInvSqrt.map (algebraMap ℚ ℂ)) := by
    rw [EI_zero]
    ring
  rw [e, PowerSeries.coeff_mul, Ftot, hsl]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [hsr, Finset.sum_eq_single_of_mem p hp]
  · rw [hhForm_tmul, gaussF_norm lam p.1]
    have h0 := gaussF_norm 0 p.2
    simp only [Complex.ofReal_zero] at h0
    rw [h0]
    norm_num
  · intro q hq hne
    rw [hhForm_tmul]
    have h1 : p.1 ≠ q.1 := by
      intro h
      apply hne
      have hp' := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      have hq' := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      ext
      · exact h.symm
      · omega
    rw [fockForm_orth h1 (gaussF_mem_level _ _) (gaussF_mem_level _ _), zero_mul]

include hF in
/-- Equation (3.8) (sphere/paper.tex l.1060–1071). -/
theorem c2_decomp_38 (hK : Cited_KacDeterminant) (lam : ℝ) (hlam : 0 < lam) :
    ∃ c : ℕ → ℂ,
      (∀ N : ℕ,
        PowerSeries.coeff N (detInvSqrt.map (algebraMap ℚ ℂ) *
            (PowerSeries.exp ℂ).subst (PowerSeries.C ((lam : ℂ) ^ 2) *
              I0def sigmaStar (fun m => -sigmaStar m)) *
            detInvSqrt.map (algebraMap ℚ ℂ)) =
          ∑ n ∈ Finset.range (N + 1), c n *
            RatFunc.eval (RingHom.id ℂ) ((lam : ℂ) ^ 2 + (n : ℂ))
              (Bsph (2 : ℂ) (fun _ => (1 / 8 : ℂ)) (N - n))) ∧
      ∀ (n : ℕ) (ι : Type) [Fintype ι] [DecidableEq ι]
        (P : Module.Basis ι ℂ (primSpace (lam : ℂ) n)),
        (primGram fun a => (P a : HH)).det ≠ 0 ∧
        c n = primCoef (fun a => (P a : HH)) (Ftot (lam : ℂ) n) := by
  have hproj : ∀ n : ℕ, ∃ w ∈ (hhUVir hF lam).prim n, ∀ y ∈ (hhUVir hF lam).prim n,
      (hhUVir hF lam).form y (Ftot (lam : ℂ) n - w) = 0 := fun n => by
    have : Module.Finite ℂ ((hhUVir hF lam).prim n) := primSpace_finite (lam : ℂ) n
    exact (hhUVir hF lam).exists_proj _ _
  choose p hp hpo using hproj
  refine ⟨fun n => hhForm (p n) (p n), fun N => ?_, fun n ι _ _ P => ?_⟩
  · have h0 := UVir.norm_decomp (R := hhUVir hF lam)
      (fun n M => gram_det_ne_zero_hh hK lam hlam n M) (Ftot_isWard hF lam) p hp hpo N
    have e2 : (((2 : ℝ)) : ℂ) = 2 := by norm_num
    have eh : ((lam ^ 2 : ℝ) : ℂ) = (lam : ℂ) ^ 2 := by push_cast; ring
    have e8 : (((1 / 8 : ℝ)) : ℂ) = 1 / 8 := by norm_num
    change hhForm (Ftot (lam : ℂ) N) (Ftot (lam : ℂ) N) =
      ∑ n ∈ Finset.range (N + 1), hhForm (p n) (p n) *
        ∑ Y : Nat.Partition (N - n), ∑ Z : Nat.Partition (N - n),
          gammaY (((lam ^ 2 : ℝ) : ℂ) + (n : ℂ)) (((1 / 8 : ℝ)) : ℂ) (((1 / 8 : ℝ)) : ℂ) Y.word *
            (gram (((2 : ℝ)) : ℂ) (((lam ^ 2 : ℝ) : ℂ) + (n : ℂ)) (N - n))⁻¹ Y Z *
            gammaY (((lam ^ 2 : ℝ) : ℂ) + (n : ℂ)) (((1 / 8 : ℝ)) : ℂ) (((1 / 8 : ℝ)) : ℂ)
              Z.word at h0
    rw [e2, eh, e8, Ftot_norm hF lam N] at h0
    show PowerSeries.coeff N (detInvSqrt.map (algebraMap ℚ ℂ) * EI ((lam : ℂ) ^ 2) *
        detInvSqrt.map (algebraMap ℚ ℂ)) = _
    rw [h0]
    refine Finset.sum_congr rfl fun n _ => ?_
    have hG : (gram (2 : ℂ) ((lam : ℂ) ^ 2 + (n : ℂ)) (N - n)).det ≠ 0 := by
      have h := gram_det_ne_zero_hh hK lam hlam n (N - n)
      rwa [e2, eh] at h
    have hev := evalAt_Bsph (c := (2 : ℂ)) (z := (lam : ℂ) ^ 2 + (n : ℂ))
      (fun _ => (1 / 8 : ℂ)) (M := N - n) hG
    rw [evalAt] at hev
    rw [hev]
  · have h := UVir.coefG_eq (R := hhUVir hF lam) ((hhUVir hF lam).prim n) P
      (Ftot (lam : ℂ) n) (p n) (hp n) (hpo n)
    exact ⟨h.1, h.2.symm⟩

end Cited

