import Virasoro.Sphere.Proofs.Sec3UVirDim
import Virasoro.Sphere.Proofs.Sec3C2Decomp

/-!
# Lemma 3.7, Step 1: `dim 𝒫_n(λ) = p(n)` (sphere paper)

sphere/paper.tex l.1056–1060: comparing the graded characters
`∏(1-t^m)^{-2} / ∏(1-t^m)^{-1} = ∑ p(n) t^n` shows that the primary space `𝒫_n(λ)` has
dimension `p(n)`.  Level `N` of `ℋ_λ` has dimension `∑_{a+b=N} p(a)p(b)`, and it is the direct
sum of the level-`N` parts of the Verma modules generated by the primaries.
-/

namespace Virasoro.Sphere

open MvPolynomial Verma

theorem finrank_span_basis_image {ι M : Type*} [AddCommGroup M] [Module ℂ M]
    (b : Module.Basis ι ℂ M) (T : Finset ι) :
    Module.finrank ℂ (Submodule.span ℂ (b '' (T : Set ι))) = T.card := by
  have hli : LinearIndependent ℂ (fun x : T => b x) :=
    b.linearIndependent.comp _ Subtype.val_injective
  have hr : Set.range (fun x : T => b x) = b '' (T : Set ι) := by
    ext v
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨x, x.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  rw [← hr, finrank_span_eq_card hli, Fintype.card_coe]

theorem levelSub_eq_span (n : ℕ) :
    levelSub n = Submodule.span ℂ
      ((basisMonomials ℕ+ ℂ) '' ((finite_level n).toFinset : Set (ℕ+ →₀ ℕ))) := by
  apply le_antisymm
  · intro f hf
    rw [Module.Basis.mem_span_image]
    intro α hα
    have h1 : coeff α f ≠ 0 := Finsupp.mem_support_iff.mp (Finset.mem_coe.mp hα)
    rw [Finset.mem_coe, Set.Finite.mem_toFinset]
    exact hf h1
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨α, hα, rfl⟩
    rw [Finset.mem_coe, Set.Finite.mem_toFinset] at hα
    have h := monomial_mem_levelSub α
    rw [show lvl α = n from hα] at h
    exact h

section Cited

variable (hF : Cited_FeiginFuchsOperators) (hK : Cited_KacDeterminant)

include hF hK in
/-- `dim (ℱ)_n = p(n)` (sphere/paper.tex l.480–482). -/
theorem finrank_levelSub (n : ℕ) :
    Module.finrank ℂ (levelSub n) = Fintype.card (Nat.Partition n) := by
  refine le_antisymm (finrank_levelSub_le n) ?_
  let v' : Nat.Partition n → levelSub n :=
    fun Y => ⟨fockWord ((1 : ℝ) : ℂ) ((1 : ℝ) : ℂ) Y.word, fw_mem_level 1 1 Y⟩
  have hli : LinearIndependent ℂ v' := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have h1 := congrArg (levelSub n).subtype hg
    simp only [map_sum, map_smul, map_zero, Submodule.subtype_apply] at h1
    have h2 := gram_li (fun Y : Nat.Partition n => fockWord ((1 : ℝ) : ℂ) ((1 : ℝ) : ℂ) Y.word)
      (gram (1 + 24 * ((1 : ℝ) : ℂ) ^ 2) (((1 : ℝ) : ℂ) ^ 2 + ((1 : ℝ) : ℂ) ^ 2) n)
      (gram_det_ne_zero_fock hK 1 1 one_pos one_pos n)
      (fun Y Y' => fock_gram_iso hF 1 1 Y Y') g h1
    exact fun i => congrFun h2 i
  exact hli.fintype_card_le_finrank

include hF hK in
theorem card_finite_level (n : ℕ) :
    (finite_level n).toFinset.card = Fintype.card (Nat.Partition n) := by
  rw [← finrank_levelSub hF hK n, levelSub_eq_span, finrank_span_basis_image]

include hF hK in
/-- `dim (ℋ_λ)_N = ∑_{a+b=N} p(a) p(b)`. -/
theorem finrank_hhLevel (N : ℕ) :
    Module.finrank ℂ (hhLevel N) = ∑ n ∈ Finset.range (N + 1),
      Fintype.card (Nat.Partition n) * Fintype.card (Nat.Partition (N - n)) := by
  classical
  have h1 : hhLevel N = Submodule.span ℂ
      (hhBasis '' ((finite_level_pair N).toFinset : Set ((ℕ+ →₀ ℕ) × (ℕ+ →₀ ℕ)))) := by
    rw [Set.Finite.coe_toFinset]
    rfl
  have h2 : (finite_level_pair N).toFinset =
      (Finset.HasAntidiagonal.antidiagonal N).biUnion
        (fun q : ℕ × ℕ => (finite_level q.1).toFinset ×ˢ (finite_level q.2).toFinset) := by
    ext ⟨α, β⟩
    simp only [Set.Finite.mem_toFinset, Set.mem_ofPred_eq, Finset.mem_biUnion, Finset.mem_product,
      Finset.HasAntidiagonal.mem_antidiagonal]
    constructor
    · intro h
      exact ⟨(lvl α, lvl β), h, rfl, rfl⟩
    · rintro ⟨q, hq, h3, h4⟩
      rw [h3, h4]
      exact hq
  rw [h1, finrank_span_basis_image, h2, Finset.card_biUnion]
  · rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Finset.card_product, card_finite_level hF hK, card_finite_level hF hK]
  · intro q _ q' _ hne
    show Disjoint ((finite_level q.1).toFinset ×ˢ (finite_level q.2).toFinset)
      ((finite_level q'.1).toFinset ×ˢ (finite_level q'.2).toFinset)
    rw [Finset.disjoint_left]
    rintro ⟨α, β⟩ h3 h4
    rw [Finset.mem_product, Set.Finite.mem_toFinset, Set.Finite.mem_toFinset] at h3 h4
    apply hne
    ext
    · exact h3.1.symm.trans h4.1
    · exact h3.2.symm.trans h4.2

include hF hK in
/-- `dim 𝒫_n(λ) = p(n)` (sphere/paper.tex l.1056–1060). -/
theorem finrank_primSpace (lam : ℝ) (hlam : 0 < lam) (n : ℕ) :
    Module.finrank ℂ (primSpace (lam : ℂ) n) = Fintype.card (Nat.Partition n) :=
  UVir.finrank_prim (R := hhUVir hF lam) (fun n M => gram_det_ne_zero_hh hK lam hlam n M)
    (fun N => finrank_hhLevel hF hK N) n

include hF hK in
/-- Lemma 3.7, Step 1 (sphere/paper.tex l.1029–1071). -/
theorem sub_c2_step1 : Stmt_sub_c2_step1 := fun lam hlam =>
  ⟨fun n => finrank_primSpace hF hK lam hlam n, c2_decomp_38 hF hK lam hlam⟩

end Cited

end Virasoro.Sphere
