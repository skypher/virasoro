import Virasoro.Statements.Sec5b
import Virasoro.Statements.Sec7
import Mathlib.Analysis.Calculus.Deriv.Basic

/-!
# Frozen statements: Section 8 (The energy-module level-seven diamond)
-/

namespace Virasoro

open Polynomial

/-- `φ₅ = (L_{-1}⁵ - 15 L_{-2} L_{-1}³ + 36 L_{-2}² L_{-1} + 99/4 L_{-3} L_{-1}² - 45 L_{-3} L_{-2}
- 54 L_{-4} L_{-1} + 45 L_{-5}) |5/2⟩`. -/
noncomputable def phi5 : St ℂ :=
  [([1, 1, 1, 1, 1], 1), ([2, 1, 1, 1], -15), ([2, 2, 1], 36), ([3, 1, 1], 99 / 4),
    ([3, 2], -45), ([4, 1], -54), ([5], 45)]

/-- `φ₄ = (L_{-1}⁴ - 40/3 L_{-2} L_{-1}² + 16 L_{-2}² + 88/3 L_{-3} L_{-1} - 152/3 L_{-4})
|7/2⟩`. -/
noncomputable def phi4 : St ℂ :=
  [([1, 1, 1, 1], 1), ([2, 1, 1], -40 / 3), ([2, 2], 16), ([3, 1], 88 / 3), ([4], -152 / 3)]

/-- Proposition 8.1 (`prop:level-seven-smith`).  Let `h_E = 1/2` and let `U₂, U₃` be the
submodules generated by `ξ₂, ξ₃`.  Their intersection is zero below level `7`, and
`(U₂ ∩ U₃)₇ = ℂ ξ₇` for a normalized singular vector `ξ₇`; `φ₅ ∈ M(1/2,5/2)` and
`φ₄ ∈ M(1/2,7/2)` are the normalized child singular vectors and
`ξ₇ = j_{ξ₂}(φ₅) = j_{ξ₃}(φ₄)`.  The `15` local Smith exponents of `G₇(1/2,h_E+x)` are
`(0⁴, 1¹⁰, 2)`, and the second crossing form of Proposition 5.3, normalized by `ξ₇`, is
`γ₇ = -700700`.
Here `j_χ(u|h+ℓ⟩) = u χ` for `u ∈ U(Vir_-)`, and `x₇` denotes the level-seven coordinates of
`ξ₇`. -/
def Stmt_prop_level_seven_smith : Prop :=
  let U₂ := Verma.negSpan (St.toVerma (c := (1 / 2 : ℂ)) (h := (1 / 2 : ℂ)) xi2)
  let U₃ := Verma.negSpan (St.toVerma (c := (1 / 2 : ℂ)) (h := (1 / 2 : ℂ)) xi3)
  let ξ₇ : Verma ℂ (1 / 2) (1 / 2) := St.toOp (1 / 2 : ℂ) phi5 • St.toVerma xi2
  let G := gramLocal (1 / 2 : ℂ) (1 / 2) 7
  Verma.IsSingular (St.toVerma (c := (1 / 2 : ℂ)) (h := (5 / 2 : ℂ)) phi5) 5 ∧
  Verma.IsSingular (St.toVerma (c := (1 / 2 : ℂ)) (h := (7 / 2 : ℂ)) phi4) 4 ∧
  ξ₇ = St.toOp (1 / 2 : ℂ) phi4 • St.toVerma (c := (1 / 2 : ℂ)) (h := (1 / 2 : ℂ)) xi3 ∧
  Verma.IsSingular ξ₇ 7 ∧
  (∀ N : ℕ, N < 7 → U₂ ⊓ U₃ ⊓ Verma.level N = ⊥) ∧
  U₂ ⊓ U₃ ⊓ Verma.level 7 = Submodule.span ℂ {ξ₇} ∧
  IsSmith G (Multiset.replicate 4 0 + Multiset.replicate 10 1 + {2}) ∧
  ∃ x₇ : Nat.Partition 7 → ℂ,
    Verma.pbwCoord 7 x₇ = ξ₇ ∧ x₇ (onesPartition 7) = 1 ∧ x₇ ∈ ker2 G ∧
    ∀ v₁ : Nat.Partition 7 → ℂ,
      (coeffMat 0 G).mulVec v₁ = -(coeffMat 1 G).mulVec x₇ → cross2 G x₇ x₇ v₁ = -700700

/-- Proposition 8.2 (`prop:no-earlier-double-pole`).  For every `N < 7` and every finite
internal weight, all local Smith exponents of `G_N(1/2,Δ)` are at most `1`; consequently
`G_N⁻¹`, `F_N` and `H_N` have at most simple poles in `Δ`. -/
def Stmt_prop_no_earlier_double_pole : Prop :=
  ∀ N : ℕ, N < 7 → ∀ lam : ℂ,
    (∀ s : Multiset ℕ, IsSmith (gramLocal (1 / 2 : ℂ) lam N) s → ∀ e ∈ s, e ≤ 1) ∧
    poleOrderInv (gramLocal (1 / 2 : ℂ) lam N) ≤ 1 ∧
    poleOrder (FN (1 / 2) N) (pt lam) ≤ 1 ∧
    poleOrder (HN (1 / 2) N) (pt lam) ≤ 1

/-- The derivative `ḣ_{r,s} = d/db h_{r,s}(b)` at `b = b₀`. -/
noncomputable def hdot0 (r s : ℤ) : ℂ := deriv (fun b : ℂ => kacH r s b) b0

/-- `𝒫_{1,5}(b₀,d) = d(d-20)(d-13)(d-11)(d-6)(d-1)(2d-15)(2d-7)(2d-5)(2d-1)/16`. -/
noncomputable def P15 : ℂ[X] :=
  C (1 / 16) * X * (X - 20) * (X - 13) * (X - 11) * (X - 6) * (X - 1) *
    (2 * X - 15) * (2 * X - 7) * (2 * X - 5) * (2 * X - 1)

/-- `𝒫_{4,1}(b₀,d) = d(d-20)(d-13)(d-11)(d-6)(d-1)(3d-14)(3d-5)/9`. -/
noncomputable def P41 : ℂ[X] :=
  C (1 / 9) * X * (X - 20) * (X - 13) * (X - 11) * (X - 6) * (X - 1) *
    (3 * X - 14) * (3 * X - 5)

/-- Lemma 8.3 (`lem:level-seven-constants`).  At `b₀ = 2i/√3`:
`𝒜_{2,1} = 9/28`, `𝒜_{1,3} = -8/105`, `𝒜_{1,5} = -1/102375`, `𝒜_{4,1} = 3/61600`;
`16 ḣ_{r,s}/(i√3) = -16, 24, 72, -80` for `(r,s) = (2,1), (1,3), (1,5), (4,1)`;
`(ḣ_{2,1}-ḣ_{1,3})/(ḣ_{2,1}-ḣ_{1,5}) = 5/11`, `(ḣ_{1,3}-ḣ_{2,1})/(ḣ_{1,3}-ḣ_{4,1}) = 5/13`,
`5/11 𝒜_{2,1} 𝒜_{1,5} = 5/13 𝒜_{1,3} 𝒜_{4,1} = -1/700700`; `𝒫_{2,1}(b₀,d) = E₂(d)`,
`𝒫_{1,3}(b₀,d) = E₃(d)`, `𝒫_{1,5}(b₀,d)` and `𝒫_{4,1}(b₀,d)` are the displayed polynomials, and
`E₂ 𝒫_{1,5} = E₃ 𝒫_{4,1}`. -/
def Stmt_lem_level_seven_constants : Prop :=
  (genA 2 1 b0 = 9 / 28 ∧ genA 1 3 b0 = -8 / 105 ∧ genA 1 5 b0 = -1 / 102375 ∧
    genA 4 1 b0 = 3 / 61600) ∧
  (16 * hdot0 2 1 / (Complex.I * (Real.sqrt 3 : ℂ)) = -16 ∧
    16 * hdot0 1 3 / (Complex.I * (Real.sqrt 3 : ℂ)) = 24 ∧
    16 * hdot0 1 5 / (Complex.I * (Real.sqrt 3 : ℂ)) = 72 ∧
    16 * hdot0 4 1 / (Complex.I * (Real.sqrt 3 : ℂ)) = -80) ∧
  ((hdot0 2 1 - hdot0 1 3) / (hdot0 2 1 - hdot0 1 5) = 5 / 11 ∧
    (hdot0 1 3 - hdot0 2 1) / (hdot0 1 3 - hdot0 4 1) = 5 / 13 ∧
    5 / 11 * genA 2 1 b0 * genA 1 5 b0 = -1 / 700700 ∧
    5 / 13 * genA 1 3 b0 * genA 4 1 b0 = -1 / 700700) ∧
  (∀ d : ℂ, genP 2 1 b0 d = E2.eval d ∧ genP 1 3 b0 d = E3.eval d ∧
    genP 1 5 b0 d = P15.eval d ∧ genP 4 1 b0 d = P41.eval d) ∧
  E2 * P15 = E3 * P41

/-- The partitions of `n` with all parts at most `k`, as weakly decreasing words, in decreasing
lexicographic order (`fuel` bounds the recursion depth). -/
def lexWordsAux : ℕ → ℕ → ℕ → List (List ℕ)
  | 0, _, _ => []
  | _ + 1, 0, _ => [[]]
  | _ + 1, _ + 1, 0 => []
  | fuel + 1, n + 1, k + 1 =>
      (if k + 1 ≤ n + 1 then
        (lexWordsAux fuel (n + 1 - (k + 1)) (k + 1)).map fun w => (k + 1) :: w
      else []) ++ lexWordsAux fuel (n + 1) k

/-- The partitions of `n` as weakly decreasing words, in decreasing lexicographic order. -/
def lexWords (n : ℕ) : List (List ℕ) := lexWordsAux (2 * n + 1) n n

/-- One row of the table of Lemma 8.4 for the label `(r,s)`, `m = r s`, the weight `h` and the
determinant `D`.

First part: `S₁`, `S₂` are the matrices of `L₁`, `L₂` on `M(1/2,h)_m` in PBW bases (rows indexed
by the partitions of `m-1`, resp. `m-2`, columns by the partitions of `m`, all in decreasing
lexicographic order); `B_m(1/2,h)` consists of the first `p(m)-1` rows of the stacked matrix
(`L₁`-rows before `L₂`-rows) followed by the coordinate row of `L_{-1}^m`; and
`det B_m(1/2,h) = D`.

Second part: the normalized singular vector `χ_{r,s}(b)` of Proposition 6.2, with coordinates
`p` over `ℂ(b)`, is regular at `b = b₀`; its value `p₀` there is the normalized singular vector
of level `r s` in `M(1/2,h)`; and both identities of Proposition 6.2 hold at `b₀`. -/
def RegularCase (r s : ℕ) (h D : ℂ) : Prop :=
  kacH r s b0 = h ∧
  (∃ S₁ S₂ : List ℕ → List ℕ → ℂ,
    (∀ Y ∈ lexWords (r * s),
      Verma.L 1 (Verma.neg (c := (1 / 2 : ℂ)) (h := h) Y) =
        ((lexWords (r * s - 1)).map fun Z => S₁ Z Y • Verma.neg (c := (1 / 2 : ℂ)) (h := h) Z).sum) ∧
    (∀ Y ∈ lexWords (r * s),
      Verma.L 2 (Verma.neg (c := (1 / 2 : ℂ)) (h := h) Y) =
        ((lexWords (r * s - 2)).map fun Z => S₂ Z Y • Verma.neg (c := (1 / 2 : ℂ)) (h := h) Z).sum) ∧
    (let rows : List (List ℕ → ℂ) :=
        ((lexWords (r * s - 1)).map fun Z => S₁ Z) ++ ((lexWords (r * s - 2)).map fun Z => S₂ Z)
     let Brows : List (List ℕ → ℂ) :=
        rows.take ((lexWords (r * s)).length - 1) ++
          [fun Y => if Y = List.replicate (r * s) 1 then 1 else 0]
     (Matrix.of fun i j : Fin (lexWords (r * s)).length =>
        (Brows.getD i 0) ((lexWords (r * s)).getD j [])).det = D)) ∧
  (∀ p : Nat.Partition (r * s) → RatFunc ℂ, p (onesPartition (r * s)) = 1 →
    Verma.IsSingular
      (Verma.pbwCoord (c := kacC (RatFunc.X : RatFunc ℂ)) (h := kacH r s RatFunc.X)
        (r * s) p) (r * s) →
    (∀ Y, (p Y).denom.eval b0 ≠ 0) ∧
    (let p₀ : Nat.Partition (r * s) → ℂ := fun Y => RatFunc.eval (RingHom.id ℂ) b0 (p Y)
     p₀ (onesPartition (r * s)) = 1 ∧
     Verma.IsSingular (Verma.pbwCoord (c := (1 / 2 : ℂ)) (h := h) (r * s) p₀) (r * s) ∧
     (∀ p' : Nat.Partition (r * s) → ℂ, p' (onesPartition (r * s)) = 1 →
       Verma.IsSingular (Verma.pbwCoord (c := (1 / 2 : ℂ)) (h := h) (r * s) p') (r * s) →
       p' = p₀) ∧
     crossScalar (1 / 2 : ℂ) h p₀ = (genA r s b0)⁻¹ ∧
     ∀ d : ℂ, torusForm (1 / 2 : ℂ) h d (r * s) p₀ p₀ = genP r s b0 d))

/-- Lemma 8.4 (`lem:regular-families`): the table of regularity determinants
`det B_m(1/2,h)` for the eight labels `(2,1), (1,3), (1,2), (2,2), (1,5), (4,1), (4,2), (1,6)`,
and for each of them the regularity at `b₀` of the normalized singular vector `χ_{r,s}(b)` with
both identities of Proposition 6.2 at `b₀`; see `RegularCase`. -/
def Stmt_lem_regular_families : Prop :=
  RegularCase 2 1 (1 / 2) 3 ∧
  RegularCase 1 3 (1 / 2) 12 ∧
  RegularCase 1 2 (1 / 16) 3 ∧
  RegularCase 2 2 (1 / 16) (-675 / 2) ∧
  RegularCase 1 5 (5 / 2) 91350 ∧
  RegularCase 4 1 (7 / 2) (-2730) ∧
  RegularCase 4 2 (33 / 16) (-17116376343198212705625 / 32) ∧
  RegularCase 1 6 (65 / 16) (505194765075 / 32)

/-- The polynomial `Θ₇(d)` of equation (A.1). -/
noncomputable def Theta7 : ℂ[X] :=
  -(C (1 / 2164322160000) * X ^ 2 * (X - 1) ^ 2 * (2 * X - 15) * (2 * X - 7) * (2 * X - 5) *
      (2 * X - 1) * (3 * X - 14) * (3 * X - 5) *
      (84001 * X ^ 4 - 3376370 * X ^ 3 + 44478887 * X ^ 2 - 209562838 * X + 205096320))

/-- Theorem 8.5 (`thm:level-seven-principal-part`).  With
`Q₅ᴱ = ∂_z{(z-5/2) H₅(1/2,z,d)}|_{z=5/2}`, `Q₄ᴱ = ∂_z{(z-7/2) H₄(1/2,z,d)}|_{z=7/2}` and
`Θ₇ = T₁ + T₂` the derivative term of Proposition 7.7 for `κ₁ = (2,1)`, `τ₁ = (1,5)`,
`κ₂ = (1,3)`, `τ₂ = (4,1)`, whose factored form is (A.1),
`PP_{Δ=1/2} H₇(1/2,Δ,d) = - E₂ 𝒫_{1,5}(b₀,d) / (700700 (Δ-1/2)²)
   + (9/28 E₂ Q₅ᴱ - 8/105 E₃ Q₄ᴱ + Θ₇)/(Δ-1/2)`  (8.1).
With `d` indeterminate, this is the earliest double pole among the coefficients
`H_N(1/2,Δ,d)`. -/
def Stmt_thm_level_seven_principal_part : Prop :=
  let Q5 : Kd := finitePart (1 / 2) 5 (5 / 2)
  let Q4 : Kd := finitePart (1 / 2) 4 (7 / 2)
  let Θ7 : Kd := Tterm b0 (2, 1) (1, 5) + Tterm b0 (1, 3) (4, 1)
  Θ7 = algebraMap ℂ[X] Kd Theta7 ∧
  PP (HN (1 / 2) 7) (pt (1 / 2)) =
    poleTerm (-(algebraMap ℂ[X] Kd (E2 * P15)) / 700700) (1 / 2) 2 +
    poleTerm ((9 / 28 : Kd) * algebraMap ℂ[X] Kd E2 * Q5
      - (8 / 105 : Kd) * algebraMap ℂ[X] Kd E3 * Q4 + Θ7) (1 / 2) 1 ∧
  poleOrder (HN (1 / 2) 7) (pt (1 / 2)) = 2 ∧
  ∀ N : ℕ, N < 7 → ∀ lam : ℂ, poleOrder (HN (1 / 2) N) (pt lam) ≤ 1

end Virasoro
