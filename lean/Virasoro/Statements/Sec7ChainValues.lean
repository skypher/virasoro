import Virasoro.Statements.Sec7FixedCharge

/-!
# Statement: Corollary 7.16 of `paper.tex` (chain values from data at the fixed charge)

Paper: `paper.tex`, Section 7.2, Corollary 7.16 (`cor:chain-values`), version of 2026-11-27.
Reading conventions as in `Virasoro.Statements.Sec7FixedCharge`: the value of a chain function at
`b⋆` is `(chainFnC b a D k j).coeff 0`; `∂_Δ^j (H_m(c⋆,·) - PP_{Δ=ν} H_m(c⋆,·))` at `Δ = ν` is
`j!` times the coefficient of `(Δ - ν)^j` in the Laurent expansion of `H_m(c⋆,·)` at `ν`; the
series over `j` in (7.9) is cut at `J`, exactly for `J` large (the values vanish for `j` large,
Theorem 7.14).  "A polynomial with rational coefficients in the coefficients of the Laurent
expansions at the points `a + n`, `0 ≤ n < μ - a`, of the functions `H_m(c⋆,Δ,d)`,
`1 ≤ m ≤ μ - a`" is membership in the `ℚ`-subalgebra of `ℂ(d)` generated by these coefficients.
-/

namespace Virasoro

open scoped LaurentSeries

/-- The coefficients of the Laurent expansions of `H_m(c⋆,·,d)`, `1 ≤ m ≤ D`, at the points
`a + n`, `0 ≤ n < D`. -/
def chainData (b a : ℂ) (D : ℕ) : Set Kd :=
  {x | ∃ m n : ℕ, 1 ≤ m ∧ m ≤ D ∧ n < D ∧ ∃ e : ℤ, x = lcoeff (HN (kacC b) m) (pt (a + n)) e}

/-- Corollary 7.16 (`cor:chain-values`).  For `b⋆ ≠ 0`:
(7.9) for `M ≥ 1`, `a ∈ Kac_M(b⋆)`, `μ = a + M`, `k ≥ 1`:
`c^{(k)}_{a→μ,0}(b⋆) = A⋆_{a,k,M} - ∑_{0<ν-a<M} ∑_j c^{(k)}_{a→ν,j}(b⋆) ∂^j(H_{μ-ν} - PP_ν H_{μ-ν})(ν)`;
(7.10) for all `a`, `ν = a + D` and `k, j ≥ 1`:
`j c^{(k)}_{a→ν,j}(b⋆) = c^{(k+1)}_{a→ν,j-1}(b⋆) - ∑_{ν'} c^{(k)}_{a→ν',0}(b⋆) c^{(1)}_{ν'→ν,j-1}(b⋆)`;
and every value `c^{(k)}_{a→a+D,j}(b⋆)`, `D ≥ 1`, is a polynomial with rational coefficients in
the Laurent coefficients of `H_m(c⋆,·,d)`, `1 ≤ m ≤ D`, at the points `a + n`, `0 ≤ n < D`. -/
def Stmt_cor_chain_values : Prop :=
  ∀ b : ℂ, b ≠ 0 →
    (∀ M : ℕ, 1 ≤ M → ∀ a ∈ Lam M b, ∀ k : ℕ, 1 ≤ k →
      ∃ J₀ : ℕ, ∀ J : ℕ, J₀ ≤ J →
        (chainFnC b a M k 0).coeff 0 =
          Astar b M a k -
            ∑ n ∈ Finset.Ioo 0 M, ∑ j ∈ Finset.range J,
              (chainFnC b a n k j).coeff 0 *
                ((j.factorial : Kd) * lcoeff (HN (kacC b) (M - n)) (pt (a + n)) j)) ∧
    (∀ (a : ℂ) (D k j : ℕ), 1 ≤ D → 1 ≤ k → 1 ≤ j →
      (j : Kd) * (chainFnC b a D k j).coeff 0 =
        (chainFnC b a D (k + 1) (j - 1)).coeff 0 -
          ∑ n ∈ Finset.Ioo 0 D,
            (chainFnC b a n k 0).coeff 0 * (chainFnC b (a + n) (D - n) 1 (j - 1)).coeff 0) ∧
    (∀ (a : ℂ) (D k j : ℕ), 1 ≤ D → 1 ≤ k →
      (chainFnC b a D k j).coeff 0 ∈ Algebra.adjoin ℚ (chainData b a D))

end Virasoro
